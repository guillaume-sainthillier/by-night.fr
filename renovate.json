{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "platformAutomerge": true,
    "automergeType": "pr",
    "minimumReleaseAge": "3 days",
    "packageRules": [
        {
            "matchUpdateTypes": ["minor", "patch", "digest"],
            "automerge": true
        },
        {
            "matchUpdateTypes": ["major"],
            "automerge": false
        },
        {
            "matchManagers": ["composer"],
            "rangeStrategy": "bump"
        },
        {
            "matchManagers": ["composer"],
            "matchDepNames": ["php"],
            "enabled": false
        },
        {
            "description": "docker/base is published under the immutable tag in docker/base/VERSION, which must be bumped by hand along with any change, so never automerge it",
            "matchFileNames": ["docker/base/**"],
            "automerge": false
        }
    ]
}
