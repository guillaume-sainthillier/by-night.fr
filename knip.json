{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "entry": [
        "assets/js/app.js",
        "assets/js/admin.js",
        "assets/js/pages/*.js",
        "assets/**/controllers/**/*.{js,jsx}",
        "assets/**/icons/**/*.{js,jsx}"
    ],
    "project": [
        "assets/**/*.{js,jsx,ts,tsx}"
    ],
    "ignore": [
        "assets/js/types.js"
    ],
    "paths": {
        "@/*": [
            "assets/*"
        ]
    },
    "ignoreBinaries": [
        "vendor/bin/.+"
    ],
    "rules": {
        "unlisted": "off",
        "unresolved": "off"
    },
    "ignoreDependencies": [
        "es6-promise",
        "glob-all"
    ]
}
