{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "entry": [
        "assets/js/pages/*.ts",
        "assets/**/controllers/**/*.{ts,tsx}",
        "assets/**/icons/**/*.{ts,tsx}"
    ],
    "paths": {
        "@/*": [
            "assets/*"
        ]
    },
    "rules": {
        "unlisted": "off",
        "unresolved": "off"
    },
    "ignoreDependencies": [
        "glob-all",
        "@fontsource-variable/epilogue"
    ]
}
