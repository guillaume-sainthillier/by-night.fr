{
    "private": true,
    "browserslist": [
        "last 2 versions"
    ],
    "engines": {
        "node": ">=24.0.0"
    },
    "dependencies": {
        "@algolia/autocomplete-js": "^1.19.12",
        "@algolia/autocomplete-plugin-recent-searches": "^1.19.12",
        "@algolia/autocomplete-theme-classic": "^1.19.12",
        "@fontsource-variable/epilogue": "^5.3.0",
        "@googlemaps/js-api-loader": "^2.1.3",
        "@maskito/core": "^5.6.0",
        "@maskito/kit": "^5.6.0",
        "@sentry/browser": "^11.4.0",
        "@tabler/core": "^1.6.1",
        "@tarekraafat/autocomplete.js": "^10.2.10",
        "fancybox": "^3.0.1",
        "hotkeys-js": "^4.0.8",
        "jquery": "^3.7.1",
        "lodash": "^4.18.1",
        "nouislider": "^15.8.1",
        "preact": "^11.0.0",
        "preact-render-to-string": "^6.8.0",
        "summernote": "^0.9.1",
        "sweetalert2": "^11.26.25",
        "tom-select": "^2.6.2",
        "vanilla-calendar-pro": "^3.4.0"
    },
    "resolutions": {
        "jquery": "3.7.1",
        "@algolia/autocomplete-js/preact": "^11.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@hotwired/stimulus": "^3.2.2",
        "@svgr/cli": "^8.1.0",
        "@symfony/reprise": "^1.3.0",
        "@vitest/coverage-v8": "^5.0.3",
        "es6-promise": "^4.2.8",
        "glob-all": "^3.3.1",
        "husky": "^9.1.7",
        "knip": "^6",
        "lint-staged": ">=17.6.0",
        "postcss-prefix-custom-properties": "^0.1.0",
        "prettier": "^3.9.9",
        "sass": "1.105.*",
        "vite": "^8.3.3",
        "vitest": "^5.0.3"
    },
    "scripts": {
        "dev-server": "vite",
        "dev": "vite build --mode development",
        "watch": "vite build --mode development --watch",
        "build": "vite build",
        "knip": "knip",
        "prepare": "husky",
        "icon:svg": "svgr --icon --out-dir assets/js/icons --ext jsx --no-index --jsx-runtime classic-preact -- assets/icons",
        "lint": "biome check --write assets",
        "lint-ci": "biome check assets",
        "prettier": "prettier --write \"assets/**/*.{scss,md}\"",
        "format": "yarn lint && yarn prettier",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,mjs,json}": "biome check --write --no-errors-on-unmatched",
        "*.{scss,md,yaml,yml}": "prettier --write",
        "*.php": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "*.twig": "vendor/bin/twig-cs-fixer lint --fix --config=.twig-cs-fixer.php"
    }
}
