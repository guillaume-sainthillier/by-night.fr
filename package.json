{
    "private": true,
    "browserslist": [
        "last 2 versions"
    ],
    "engines": {
        "node": ">=24.0.0"
    },
    "dependencies": {
        "@algolia/autocomplete-js": "^1.19.4",
        "@algolia/autocomplete-plugin-recent-searches": "^1.19.4",
        "@algolia/autocomplete-theme-classic": "^1.19.4",
        "@googlemaps/js-api-loader": "^2.0.2",
        "@sentry/browser": "^10.38.0",
        "@tabler/core": "^1.4.0",
        "@tarekraafat/autocomplete.js": "^10.2.9",
        "cookieconsent": "^3.1.1",
        "daterangepicker": "^3.1.0",
        "fancybox": "^3.0.0",
        "hotkeys-js": "^4.0.0",
        "jquery": "^3.7.1",
        "lodash": "^4.17.23",
        "moment": "2.30.1",
        "morris.js": "^0.5.0",
        "preact": "^10.28.3",
        "preact-render-to-string": "^6.6.5",
        "raphael": "^2.2.7",
        "summernote": "^0.9.1",
        "sweetalert2": "^11.26.18",
        "tom-select": "^2.4.6"
    },
    "resolutions": {
        "bootstrap": "5.3.7"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@hotwired/stimulus": "^3.0.0",
        "@svgr/cli": "^8.1.0",
        "@symfony/reprise": "^1.1.3",
        "@vitest/coverage-v8": "^5.0.1",
        "es6-promise": "^4.2.6",
        "glob-all": "^3.3.1",
        "husky": "^9.1.6",
        "knip": "^6",
        "lint-staged": ">=16.2.7",
        "prettier": "^3.8.1",
        "sass": "1.104.*",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    },
    "scripts": {
        "dev-server": "vite",
        "dev": "vite build --mode development",
        "watch": "vite build --mode development --watch",
        "build": "vite build",
        "knip": "knip",
        "prepare": "husky",
        "icon:svg": "svgr --icon --out-dir assets/js/icons --ext jsx --no-index --jsx-runtime classic-preact -- assets/icons",
        "lint": "biome check --write assets",
        "lint-ci": "biome check assets",
        "prettier": "prettier --write \"assets/**/*.{scss,md}\"",
        "format": "yarn lint && yarn prettier",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,mjs,json}": "biome check --write --no-errors-on-unmatched",
        "*.{scss,md,yaml,yml}": "prettier --write",
        "*.php": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "*.twig": "vendor/bin/twig-cs-fixer lint --fix --config=.twig-cs-fixer.php"
    }
}
