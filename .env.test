# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# The host the test clients browse (AppWebTestCase): URLs built outside a request (commands, messages) use it too
APP_URL=https://by-night.test
# The only host the test clients may browse (framework.trusted_hosts reads it): any other fails as in production
SYMFONY_TRUSTED_HOSTS='^by-night\.test$'
# The bucket's public host (the images' origin): data.by-night.fr in production
S3_PUBLIC_URL=https://data.by-night.test
SYMFONY_DEPRECATIONS_HELPER=disabled=1
PANTHER_APP_ENV=panther
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_test.db"
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
# Thumbnails on the local filesystem: the S3 thumb client has no credentials in tests/CI,
# and rendering any full page (Picasso images in the header) would otherwise hit it.
APP_THUMB_STORAGE_SOURCE=local
