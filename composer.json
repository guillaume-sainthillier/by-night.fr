{
    "name": "gsa/bynight",
    "description": "By Night",
    "homepage": "https://by-night.fr",
    "type": "project",
    "minimum-stability": "stable",
    "license": "MIT",
    "authors": [
        {
            "name": "Guillaume Sainthillier",
            "email": "hello@silarhi.fr",
            "homepage": "https://sainthillier.fr",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "/vendor/rector/swiss-knife/stubs/"
        ]
    },
    "require": {
        "php": "^8.5",
        "ext-amqp": "*",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-simplexml": "*",
        "ext-xmlreader": "*",
        "ext-zip": "*",
        "ext-zlib": "*",
        "api-platform/core": "^4.4.0",
        "aws/aws-sdk-php": "^3.395.7",
        "babdev/pagerfanta-bundle": "^4.6",
        "beberlei/doctrineextensions": "^1.5",
        "doctrine/doctrine-bundle": "^3.3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0.1",
        "doctrine/orm": "^3.7.1",
        "easycorp/easyadmin-bundle": "^5.6.0",
        "erusev/parsedown": "^1.8.0",
        "friendsofsymfony/elastica-bundle": "^7.2",
        "huluti/breadcrumbs-bundle": "^1.7",
        "jean85/pretty-package-versions": "^2.1.1",
        "karser/karser-recaptcha3-bundle": "^0.3.0",
        "knpuniversity/oauth2-client-bundle": "^2.20.2",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "league/flysystem-bundle": "^3.7.1",
        "league/flysystem-memory": "^3.31",
        "league/glide-symfony": "^2.1.0",
        "league/oauth2-facebook": "^2.2",
        "league/oauth2-google": "^5.0",
        "neitanod/forceutf8": "^2.0.4",
        "notfloran/mjml-bundle": "^3.11",
        "pagerfanta/doctrine-orm-adapter": "^4",
        "pagerfanta/twig": "^4",
        "presta/sitemap-bundle": "^4.3.1",
        "sentry/sentry-symfony": "^5.13.0",
        "silarhi/cursor-pagination": "^2.1",
        "silarhi/picasso-bundle": "^1.3.1",
        "smolblog/oauth2-twitter": "^1.2",
        "social-links/social-links": "^1.17",
        "stof/doctrine-extensions-bundle": "^1.15.3",
        "symfony/amqp-messenger": "~8.1.7",
        "symfony/apache-pack": "^1.0.1",
        "symfony/asset": "~8.1.0",
        "symfony/console": "~8.1.7",
        "symfony/css-selector": "~8.1.6",
        "symfony/doctrine-bridge": "~8.1.7",
        "symfony/dom-crawler": "~8.1.5",
        "symfony/dotenv": "~8.1.6",
        "symfony/event-dispatcher": "~8.1.5",
        "symfony/expression-language": "~8.1.6",
        "symfony/flex": "^2.11.0",
        "symfony/form": "~8.1.7",
        "symfony/framework-bundle": "~8.1.7",
        "symfony/html-sanitizer": "~8.1.7",
        "symfony/http-client": "~8.1.7",
        "symfony/http-foundation": "~8.1.7",
        "symfony/intl": "~8.1.5",
        "symfony/mailer": "~8.1.7",
        "symfony/messenger": "~8.1.7",
        "symfony/mime": "~8.1.7",
        "symfony/monolog-bridge": "~8.1.6",
        "symfony/monolog-bundle": "^4.1.0",
        "symfony/polyfill-apcu": "^1.37.0",
        "symfony/process": "~8.1.7",
        "symfony/rate-limiter": "~8.1.6",
        "symfony/reprise": "^1.2.0",
        "symfony/routing": "~8.1.6",
        "symfony/runtime": "~v8.1.0",
        "symfony/security-bundle": "~8.1.7",
        "symfony/stimulus-bundle": "^3.5.1",
        "symfony/stopwatch": "~8.1.0",
        "symfony/string": "~8.1.7",
        "symfony/translation": "~8.1.5",
        "symfony/twig-bridge": "~8.1.7",
        "symfony/twig-bundle": "~8.1.7",
        "symfony/ux-icons": "^3.5.1",
        "symfony/validator": "~8.1.7",
        "symfony/web-link": "~8.1.0",
        "symfony/yaml": "~8.1.6",
        "symfonycasts/reset-password-bundle": "^1.25",
        "symfonycasts/verify-email-bundle": "^1.18",
        "twig/extra-bundle": "^3.29.0",
        "twig/intl-extra": "^3.29.0",
        "vich/uploader-bundle": "^3.0.0"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.6",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "friendsofphp/php-cs-fixer": "^3.95.26",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.2.14",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "phpstan/phpstan-symfony": "^2.0.20",
        "phpunit/phpunit": "^13.3.4",
        "rector/rector": "^2.6.7",
        "rector/swiss-knife": "^2.6.0",
        "shipmonk/dead-code-detector": "^1.4.2",
        "symfony/browser-kit": "~8.1.5",
        "symfony/debug-bundle": "~8.1.0",
        "symfony/maker-bundle": "^1.68.0",
        "symfony/web-profiler-bundle": "~8.1.7",
        "vincentlanglet/twig-cs-fixer": "^4.1.1",
        "zenstruck/foundry": "^2.13.0"
    },
    "replace": {
        "symfony/polyfill-php85": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php80": "*"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "platform": {
            "php": "8.5.3"
        },
        "bump-after-update": true,
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "8.1.*",
            "docker": false
        }
    }
}
