# Ownership checks of the link platforms that only accept a <meta> tag, as a JSON object of name => content
# (e.g. {"linkatomic-verify-code":"..."}): set in the production env, never in the repo
SITE_VERIFICATION_METAS={}
# Umami (cookieless audience): the website's id renders the tracker; the API (a view-only user) feeds the event pages'
# visitors and ticketing clicks shown to their authors (app:events:sync-visits). Empty website id = no tracker.
UMAMI_WEBSITE_ID=
UMAMI_API_URL=http://localhost:3000/
UMAMI_USERNAME=
UMAMI_PASSWORD=
