###> doctrine/doctrine-bundle ###
# Format described at http://docs.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# For an SQLite database, use: "sqlite:///%kernel.project_dir%/var/data.db"
# Configure your db driver and server_version in config/packages/doctrine.yaml
DATABASE_URL=mysql://db_user:db_password@127.0.0.1:3306/db_name?serverVersion=8.0
###< doctrine/doctrine-bundle ###
###> sentry/sentry-symfony ###
SENTRY_DSN=
###< sentry/sentry-symfony ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> Support ###
# Blind copy of the feedback and content removal requests sent to support@by-night.fr (empty: none), set per server
SUPPORT_BCC_EMAIL=
###< Support ###
###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=doctrine://default
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_ELASTICA_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/elastica?auto_setup=false
MESSENGER_ASYNC_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/async?auto_setup=false
MESSENGER_CDN_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/cdn?auto_setup=false
MESSENGER_FAILED_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/failed?auto_setup=false
MESSENGER_FAILED_EVENT_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/failed-event?auto_setup=false
MESSENGER_PARSER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/parser?auto_setup=false
MESSENGER_IMAGE_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/image?auto_setup=false
MESSENGER_TRANSFERS_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/transfers?auto_setup=false
# Max messages/second each transport's workers will process (token_bucket, see
# rate_limiter.yaml). Tune per host; lower = gentler on CPU when draining a backlog.
MESSENGER_PARSER_RATE_LIMIT=100
MESSENGER_ELASTICA_RATE_LIMIT=100
###< symfony/messenger ###

###> karser/karser-recaptcha3-bundle ###
# Get your API key and secret from https://g.co/recaptcha/v3
RECAPTCHA3_KEY=my_site_key
RECAPTCHA3_SECRET=my_secret
###< karser/karser-recaptcha3-bundle ###

###> symfony/mercure-bundle ###
# The hub runs in its own container (docker-compose.yml), proxied on the site's origin under /.well-known/mercure.
# The URL the app publishes to (internal): the `mercure` service's port on the host in development
MERCURE_URL=http://127.0.0.1:3000/.well-known/mercure
# The URL browsers subscribe on: same origin as the pages, so the subscriber cookie reaches it
MERCURE_PUBLIC_URL=https://by-night.test/.well-known/mercure
# Signs the publisher and subscriber tokens (HS256): the hub verifies them with the same key
MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKey!
# The "iss" of the tokens: the hub only trusts this issuer (its MERCURE_TRUSTED_ISSUERS)
MERCURE_JWT_ISSUER=https://by-night.fr
###< symfony/mercure-bundle ###
