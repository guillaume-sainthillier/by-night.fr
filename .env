# and THUMBS_PROXY_CADDYFILE=/etc/frankenphp/thumbs-proxy.Caddyfile. Empty = thumbnails served by PHP.
THUMBS_BUCKET_DOMAIN=
THUMBS_PROXY_CADDYFILE=
