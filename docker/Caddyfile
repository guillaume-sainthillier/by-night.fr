{
	skip_install_trust

	# ember polls the admin API every second and each call logged a "received request" line,
	# burying the application logs: the admin API only logs its warnings and errors.
	log default {
		exclude admin.api
	}
	log admin {
		include admin.api
		level WARN
	}

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

# S3 reverse proxy CDN (data.by-night.fr)
{$DATA_SERVER_NAME} {
	# The members' imports and exports (transfers.storage): private objects, never served by this host, whatever
	# the bucket's policy says
	respond /private/* 404

	reverse_proxy https://{$DATA_BUCKET_DOMAIN} {
		header_up Host {$DATA_BUCKET_DOMAIN}
	}

	log {
		{$CADDY_SERVER_LOG_OPTIONS}
	}

	header Cache-Control "public, max-age=31536000, immutable"
}

# Main app server
{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
		# Redact the authorization query parameter that can be set by Mercure
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
		}
	}

	root * /app/public
	encode zstd br gzip

	#	mercure {
	#		# Transport to use (default to Bolt)
	#		transport_url {$MERCURE_TRANSPORT_URL:bolt:///data/mercure.db}
	#		# Publisher JWT key
	#		publisher_jwt {env.MERCURE_PUBLISHER_JWT_KEY} {env.MERCURE_PUBLISHER_JWT_ALG}
	#		# Subscriber JWT key
	#		subscriber_jwt {env.MERCURE_SUBSCRIBER_JWT_KEY} {env.MERCURE_SUBSCRIBER_JWT_ALG}
	#		# Allow anonymous subscribers (double-check that it's what you want)
	#		anonymous
	#		# Enable the subscription API (double-check that it's what you want)
	#		subscriptions
	#		# Extra directives
	#		{$MERCURE_EXTRA_DIRECTIVES}
	#	}

	# Thumbnails served from the S3 bucket, enabled per environment (see docker/thumbs-proxy.Caddyfile)
	import {$THUMBS_PROXY_CADDYFILE:/dev/null}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Disable Topics tracking if not enabled explicitly: https://github.com/jkarlin/topics
	header ?Permissions-Policy "browsing-topics=()"
	header /p/image/* Cache-Control "public, max-age=31536000, immutable"
	header /build/* Cache-Control "public, max-age=31536000, immutable"
	header /bundles/easyadmin/* Cache-Control "public, max-age=31536000, immutable"
	# Cache favicons, images and SVGs for a year
	header /images/* Cache-Control "public, max-age=31536000, immutable"
	header /*.ico Cache-Control "public, max-age=31536000, immutable"
	header /*.png Cache-Control "public, max-age=31536000, immutable"
	header /*.svg Cache-Control "public, max-age=31536000, immutable"

	# The front controller in the URL ("/index.php/paris/soiree/…", "/index.php"): php_server runs index.php for it
	# and Symfony takes "/index.php" for the base URL, so every URL the page writes, its canonical included, keeps the
	# prefix (Google indexed some). It leads to the same URL without it, query string kept: 301, 308 for a form posted
	# there so it is posted again. Read on the raw URI to keep its encoding; every leading slash or backslash goes, or
	# "/index.php//host" would send to another site. "/index.phpx" is another page.
	@frontController vars_regexp frontController {http.request.uri} (?i)^/index\.php(?:[/\\]+([^?]*))?(\?.*)?$
	@frontControllerSafe {
		vars_regexp frontController {http.request.uri} (?i)^/index\.php(?:[/\\]+([^?]*))?(\?.*)?$
		method GET HEAD
	}
	route {
		redir @frontControllerSafe /{re.frontController.1}{re.frontController.2} 301
		redir @frontController /{re.frontController.1}{re.frontController.2} 308
	}

	php_server
}
