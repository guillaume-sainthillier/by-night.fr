<section class="card card-layout mb-0 comments-container" id="comments">
    <div class="card-body">
        {{ include('comment/header.html.twig') }}
        <p class="text-secondary mb-0">Une question sur les horaires, l'accès ou le programme&nbsp;? Envie de partager vos impressions&nbsp;? Échangez avec la communauté By Night.</p>
    </div>
    {% if comments.nbResults > 0 %}
        <div class="card-body scrollable" style="max-height: 600px">
            <div class="chat">
                <div class="chat-bubbles">
                    {{ include('comment/list.html.twig') }}
                </div>
            </div>
        </div>
    {% endif %}
    <div class="card-body card-body-form">
        {{ include('comment/form.html.twig') }}
    </div>
</section>
