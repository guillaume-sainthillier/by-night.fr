{% if is_granted('ROLE_USER') %}
    {{ form_start(form) }}
    <div class="comment comment-form">
        <div class="d-flex align-items-center gap-2 mb-2">
            <twig:Tabler:Avatar size="sm">
                <twig:User:Thumb user="{{ app.user }}" width="{{ 32 }}" height="{{ 32 }}" />
            </twig:Tabler:Avatar>
            <strong>{{ app.user.username }}</strong>
        </div>
        {% block form_comment %}
            {{ form_row(form.comment, {
                attr: {
                    placeholder: 'Écrire un commentaire…',
                    rows: 3,
                },
            }) }}
        {% endblock %}
        <div class="text-end">
            <twig:Tabler:Button variant="primary" type="submit" class="btn-submit">Publier mon commentaire</twig:Tabler:Button>
        </div>
    </div>
    {{ form_end(form) }}
{% else %}
    <div class="text-center">
        {# "login": the login that leads back to the event (location/event/index.html.twig, the only page a visitor sees
           this form on) #}
        <a class="btn btn-outline-primary" title="Se connecter pour laisser un commentaire" rel="nofollow"
           href="{{ login }}">
            <twig:Tabler:Icon name="lucide:message-square-plus" />
            Se connecter pour commenter
        </a>
    </div>
{% endif %}
