{% for comment in comments %}
    {{ include('comment/item.html.twig', {comment: comment}) }}
{% endfor %}

{% if comments.hasNextPage %}
    <div class="load-more" data-comment-page="{{ comments.nextPage }}">
        <twig:Tabler:Button variant="primary" appearance="outline" type="button">
            Plus de commentaires
        </twig:Tabler:Button>
    </div>
{% endif %}
