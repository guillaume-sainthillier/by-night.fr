{# Only rendered for a member (ReplyController::new() requires ROLE_USER): the visitor gets no "Répondre" button #}
{{ form_start(form, {attr: {class: 'reply-form'}}) }}

<div class="chat-item reply-item">
    <div class="row align-items-end">
        <div class="col-auto">
            <div class="avatar avatar-sm">
                <twig:User:Thumb user="{{ app.user }}" width="{{ 32 }}" height="{{ 32 }}" />
            </div>
        </div>
        <div class="col-lg-8">
            <div class="chat-bubble chat-bubble-me chat-bubble-reply chat-bubble-form">
                <div class="chat-bubble-title">
                    <div class="row">
                        <div class="col chat-bubble-author">
                            {{ app.user.username }}
                        </div>
                    </div>
                </div>
                <div class="chat-bubble-body">
                    {{ form_row(form.comment, {
                        attr: {
                            placeholder: 'Répondre à ' ~ comment.user.username ~ '…',
                            rows: 4,
                        },
                    }) }}
                </div>
                <div class="chat-bubble-actions">
                    <button type="submit" class="btn btn-sm btn-primary">Envoyer</button>
                    <button type="button" class="btn btn-sm cancel-reply">Annuler</button>
                </div>
            </div>
        </div>
    </div>
</div>
{{ form_rest(form) }}
{{ form_end(form) }}
