{% for comment in comments %}
    {{ include('comment/reply/item.html.twig', {comment: comment}) }}
{% endfor %}

{% if comments.hasNextPage %}
    <div class="load-more mt-2 ms-4 text-start" data-comment-page="{{ comments.currentPage + 1 }}">
        <twig:Tabler:Button variant="default" type="button" class="ms-4">
            Plus de réponses
        </twig:Tabler:Button>
    </div>
{% endif %}
