{% set isCurrentUser = app.user and app.user.id == comment.user.id %}
<div class="chat-item reply-thread" data-comment-id="{{ comment.id }}">
    <div class="comment{{ isCurrentUser ? ' comment-me' }}">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="avatar avatar-sm">
                <twig:User:Thumb user="{{ comment.user }}" width="{{ 32 }}" height="{{ 32 }}" />
            </span>
            <a class="fw-semibold text-reset text-truncate" href="{{ path('app_user_index', {id: comment.user.id, slug: comment.user.slug}) }}">{{ comment.user.username }}</a>
            {% if comment.user.verified %}
                <twig:Icon name="lucide:badge-check" class="text-primary flex-shrink-0" title="Membre vérifié" />
            {% endif %}
            <span class="ms-auto small text-secondary text-nowrap" title="{{ comment.createdAt|format_datetime('medium', 'medium')|capitalize }}">{{ comment.createdAt|diff_date }}</span>
        </div>
        <div class="comment-body">
            {{ comment.comment|striptags('<i><b>')|nl2br|parse_tags|raw }}
        </div>
        {% if is_granted('ROLE_USER') %}
            <button class="btn btn-sm btn-ghost-secondary reply-link mt-2" data-url="{{ path('app_comment_reponse_new', {id: comment.id}) }}">
                <twig:Icon name="lucide:reply" class="icon-inline" /> Répondre
            </button>
        {% endif %}
    </div>
    {# Reply form container #}
    <div class="reply-form-container ms-4 ms-md-5"></div>

    {# Replies container - always visible #}
    {% set childrenSlice = comment.approvedChildren|slice(0, 6) %}
    {% if childrenSlice|length > 0 %}
        <div class="chat-bubbles replies-container mt-2 ms-4 ms-md-5">
            {% for reply in childrenSlice|slice(0, 5) %}
                {{ include('comment/reply/item.html.twig', {comment: reply}) }}
            {% endfor %}

            {# Show "Load more" if there are more than 5 replies #}
            {% if childrenSlice|length > 5 %}
                <div class="load-more mt-2 text-start" data-url="{{ path('app_comment_reponse_list', {id: comment.id, page: 2}) }}">
                    <button type="button" class="btn btn-sm">
                        Plus de réponses
                    </button>
                </div>
            {% endif %}
        </div>
    {% endif %}
</div>
