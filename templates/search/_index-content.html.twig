{% set currentType = type %}
{% set options = {
    '': 'Tout le site',
    evenements: 'Les événements',
    membres: 'Les membres',
} %}

{%- block search -%}
    <div class="row">
        <div class="col-lg-8 offset-lg-2 col-md-10 offset-md-1">
            <twig:Tabler:Card>
                <twig:Tabler:Card:Body>
                    <form method="GET" class="no-margin-form" action="{{ path('app_search_index') }}">
                        {# The city the search came from, whose events come first (SearchController) #}
                        {% if near %}
                            <input type="hidden" name="city" value="{{ near.slug }}">
                        {% endif %}
                        <div class="row">
                            <div class="col-md-6 col-lg-8">
                                <div class="mb-3">
                                    <label for="search">Je cherche</label>
                                    <twig:InputIcon iconPrepend="lucide:search">
                                        <input name="q"
                                               id="search"
                                               class="form-control"
                                               type="search"
                                               value="{{ term }}">
                                    </twig:InputIcon>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <div class="mb-3">
                                    <label for="type">Parmi</label>
                                    <select id="type" name="type" class="form-select">
                                        {% for value, label in options %}
                                            <option value="{{ value }}" {{ value == currentType ? 'selected' }}>{{ label }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="text-center">
                            <input class="btn btn-primary" type="submit" value="Rechercher" />
                        </div>
                    </form>
                </twig:Tabler:Card:Body>
            </twig:Tabler:Card>
        </div>
    </div>

    {% if term and result.count == 0 %}
        {# Nothing found: other words, or the whole site when the search kept to events or members #}
        <twig:Tabler:Empty>
            <twig:Tabler:Empty:Img><twig:Illustration name="no-results" width="{{ 200 }}" /></twig:Tabler:Empty:Img>
            <h2 class="empty-title">{{ result.message|trans({count: result.count}, 'messages+intl-icu') }}</h2>
            <twig:Tabler:Empty:Subtitle>Vérifiez l'orthographe, ou essayez un mot plus court ou plus courant.</twig:Tabler:Empty:Subtitle>
            {% if currentType %}
                <twig:Tabler:Empty:Action>
                    <a class="btn" href="{{ path('app_search_index', {q: term}) }}">
                        <twig:Tabler:Icon name="lucide:search" />
                        Chercher sur tout le site
                    </a>
                </twig:Tabler:Empty:Action>
            {% endif %}
        </twig:Tabler:Empty>
    {% elseif term %}
        <h2>
            {{ result.message|trans({count: result.count}, 'messages+intl-icu') }}
        </h2>
        {% if events.nbResults > 0 and (not type or type == 'evenements') %}
            {% if type != 'evenements' %}
                <h3>{{ '{count, plural, one {Événement} other {Événements}}'|trans({count: events.nbResults}, 'messages+intl-icu') }} <twig:Tabler:Badge variant="info" class="number number-sm">{{ events.nbResults }}</twig:Tabler:Badge>
                </h3>
            {% endif %}
            {{ include('search/content-events.html.twig') }}
        {% endif %}

        {% if users.nbResults > 0 and (not type or type == 'membres') %}
            {% if type != 'membres' %}
                <h3>{{ '{count, plural, one {Membre} other {Membres}}'|trans({count: users.nbResults}, 'messages+intl-icu') }} <twig:Tabler:Badge variant="info" class="number number-sm">{{ users.nbResults }}</twig:Tabler:Badge></h3>
            {% endif %}
            {{ include('search/content-users.html.twig') }}
        {% endif %}
    {% endif %}
{%- endblock -%}
