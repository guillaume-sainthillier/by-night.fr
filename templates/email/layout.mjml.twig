{#
 # Every e-mail extends this layout. Blocks:
 # - email_title, preheader: <title> and inbox preview text
 # - icon: name of a badge in assets/images/email/icon-<name>.png, shown above the heading
 # - heading, subheading: centered title of the card
 # - body: content of the card (a single column)
 # - body_sections: full-width sections appended to the card (e.g. multi-column button grids)
 # - footer: why the recipient gets this e-mail
 #}
{% mjml %}
    <mjml lang="fr">
        <mj-head>
            <mj-title>{% block email_title %}By Night{% endblock %}</mj-title>
            <mj-preview>{% block preheader %}{% endblock %}</mj-preview>
            <mj-attributes>
                <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
                <mj-text font-size="16px" color="#3d4048" line-height="1.6" padding="0 0 16px 0" />
                <mj-class name="h1" font-size="26px" font-weight="700" color="#191c22" line-height="1.25" align="center" padding="0 0 12px 0" />
                <mj-class name="lead" font-size="16px" color="#6f727a" align="center" padding="0 0 8px 0" />
                <mj-class name="label" font-size="12px" font-weight="700" color="#6f727a" text-transform="uppercase" letter-spacing="0.6px" padding="0 0 8px 0" />
                <mj-class name="muted" font-size="14px" color="#6f727a" line-height="1.6" />
                <mj-class name="outline" background-color="#ffffff" border="1px solid #d3d4dd" color="#3d4048" />
                <mj-button background-color="#d94826" color="#ffffff" font-size="16px" font-weight="600" border-radius="8px" inner-padding="14px 32px" padding="16px 0 24px 0" />
                <mj-divider border-color="#e5e6f0" border-width="1px" padding="8px 0 24px 0" />
                <mj-table font-size="15px" color="#3d4048" line-height="1.5" padding="0 0 16px 0" />
            </mj-attributes>
            <mj-style>
                a { color: #ae2a08; }
                .break-all a { word-break: break-all; }
                .footer a { color: #6f727a !important; text-decoration: underline; }
                .brand a { color: #191c22 !important; text-decoration: none; }
                /* MJML puts the wrapper's border on its cell and the radius on its table: round the cell too
                   (its reset collapses every table's borders, which ignores border-radius) */
                .card > table { border-collapse: separate !important; }
                .card > table > tbody > tr > td { border-radius: 12px; }
            </mj-style>
            {% block head %}{% endblock %}
        </mj-head>

        <mj-body background-color="#f2f3fd" width="600px">
            {# ── Brand ──────────────────────────────────────────── #}
            <mj-section padding="32px 16px 20px 16px">
                <mj-column>
                    <mj-text css-class="brand" align="center" padding="0">
                        <a href="{{ url('app_index') }}">
                            <img
                                src="{{ absolute_url(asset('build/images/email-logo.png')) }}"
                                alt=""
                                width="36"
                                height="36"
                                style="vertical-align: middle; border: 0;"
                            />
                            <span style="vertical-align: middle; font-size: 20px; font-weight: 700; margin-left: 8px;">By Night</span>
                        </a>
                    </mj-text>
                </mj-column>
            </mj-section>

            {# ── Card ───────────────────────────────────────────── #}
            <mj-wrapper css-class="card" background-color="#ffffff" border="1px solid #e5e6f0" border-radius="12px" padding="44px 16px 20px 16px">
                {% if block('icon') is defined %}
                    <mj-section padding="0 24px 20px 24px">
                        <mj-column>
                            <mj-image
                                src="{{ absolute_url(asset('build/images/email/icon-' ~ block('icon') ~ '.png')) }}"
                                alt=""
                                width="64px"
                                height="64px"
                                align="center"
                                padding="0"
                            />
                        </mj-column>
                    </mj-section>
                {% endif %}

                {% if block('heading') is defined %}
                    <mj-section padding="0 24px 24px 24px">
                        <mj-column>
                            <mj-text mj-class="h1">{{ block('heading') }}</mj-text>
                            {% if block('subheading') is defined %}
                                <mj-text mj-class="lead">{{ block('subheading') }}</mj-text>
                            {% endif %}
                        </mj-column>
                    </mj-section>
                {% endif %}

                <mj-section padding="0 24px">
                    <mj-column>
                        {% block body %}{% endblock %}
                    </mj-column>
                </mj-section>

                {% block body_sections %}{% endblock %}
            </mj-wrapper>

            {# ── Footer ─────────────────────────────────────────── #}
            <mj-section padding="28px 24px 40px 24px">
                <mj-column>
                    <mj-text align="center" css-class="footer" font-size="14px" color="#6f727a" padding="0 0 12px 0">
                        Une question&nbsp;? Écrivez-nous à <a href="mailto:support@by-night.fr">support@by-night.fr</a>.
                    </mj-text>
                    <mj-text align="center" css-class="footer" font-size="13px" color="#6f727a" padding="0 0 12px 0">
                        <a href="{{ url('app_about') }}">À propos</a>
                        &nbsp;·&nbsp;
                        <a href="{{ url('app_legal_mentions') }}">Mentions légales</a>
                    </mj-text>
                    <mj-text align="center" font-size="13px" color="#a0a2ab" padding="0">
                        {% block footer %}
                            Cet e-mail vous a été envoyé par By Night, l'agenda des sorties en France.
                        {% endblock %}
                        <br />© {{ 'now'|date('Y') }} By Night
                    </mj-text>
                </mj-column>
            </mj-section>
        </mj-body>
    </mjml>
{% endmjml %}
