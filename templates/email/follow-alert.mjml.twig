{% extends 'email/layout.mjml.twig' %}

{# @var user \App\Entity\User #}
{# @var events \App\Entity\Event[] the first new events, the soonest first #}
{# @var count int how many there are in all #}
{# @var unsubscribeUrl string #}

{# Every link but the unsubscribe one says where the visit comes from (|utm) #}
{% set followsUrl = url('app_follow_list')|utm('follows') %}

{% block email_title %}Nouveaux événements{% endblock %}
{% block preheader %}{{ events|slice(0, 3)|map(event => event.name)|join(', ') }}…{% endblock %}

{% block heading %}{{ '{count, plural, one {Un nouvel événement} other {# nouveaux événements}}'|trans({count: count}, 'messages+intl-icu') }}{% endblock %}
{% block subheading 'Chez les organisateurs et les lieux que vous suivez' %}

{% block body %}
    <mj-text>Bonjour {{ user.firstname ?: user.username }},</mj-text>
    <mj-text>Voici ce qu'ils viennent d'annoncer sur By Night.</mj-text>
    <mj-divider />
{% endblock %}

{% block body_sections %}
    {% for event in events %}
        {% set eventUrl = url('app_event_details', {slug: event.slug, id: event.id, location: event.locationSlug})|utm('event') %}
        {% set session = event.sessionFor %}
        {% set picture = event_picture(event) %}
        <mj-section padding="0 24px 20px 24px">
            <mj-column width="38%" vertical-align="top">
                <mj-image
                    src="{{ absolute_url(picasso_image_url(picture.src ?? '', width: 400, height: 280, fit: 'crop', format: 'jpg', loader: picture.loader, context: picture.context)) }}"
                    href="{{ eventUrl }}"
                    alt="{{ event.name }}"
                    border-radius="8px"
                    padding="0 0 8px 0"
                />
            </mj-column>
            <mj-column width="62%" vertical-align="top">
                <mj-text font-size="17px" font-weight="700" line-height="1.35" padding="0 0 6px 12px">
                    <a href="{{ eventUrl }}" style="color: #191c22; text-decoration: none;">{{ event.name }}</a>
                </mj-text>
                <mj-text mj-class="muted" padding="0 0 0 12px">
                    {% if session %}
                        {{ session.startAt|format_date(pattern: 'EEEE d MMMM')|capitalize }}
                        {%- if session.endAt and session.endAt|date('Y-m-d') != session.startAt|date('Y-m-d') %} au {{ session.endAt|format_date(pattern: 'EEEE d MMMM') }}{% endif %}
                        {%- set hours = session_hours(session) %}
                        {%- if hours %} · {{ hours }}{% endif %}
                        <br />
                    {% endif %}
                    {% if event.placeName %}
                        {{ event.placeName }}{% if event.placeCity %}, {{ event.placeCity }}{% endif %}
                    {% endif %}
                    {% if event.publisher %}
                        <br />Par {{ event.publisher.name }}
                    {% endif %}
                </mj-text>
            </mj-column>
        </mj-section>
    {% endfor %}

    {% if count > events|length %}
        <mj-section padding="0 24px 8px 24px">
            <mj-column>
                <mj-text mj-class="muted" align="center">{{ '{count, plural, one {Et un autre} other {Et # autres}}'|trans({count: count - events|length}, 'messages+intl-icu') }} sur leurs pages.</mj-text>
            </mj-column>
        </mj-section>
    {% endif %}

    <mj-section padding="0 24px 8px 24px">
        <mj-column>
            <mj-button href="{{ followsUrl }}">Voir mes abonnements</mj-button>
        </mj-column>
    </mj-section>
{% endblock %}

{% block footer %}
    Vous recevez cet e-mail car vous suivez des organisateurs ou des lieux sur By Night.
    <br /><a href="{{ unsubscribeUrl }}" style="color: #a0a2ab;">Ne plus recevoir ces e-mails</a>
    &nbsp;·&nbsp;
    <a href="{{ url('app_user_edit')|utm('preferences') }}" style="color: #a0a2ab;">Gérer mes préférences</a>
{% endblock %}
