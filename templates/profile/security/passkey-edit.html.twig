{% extends 'profile/security/_layout.html.twig' %}

{% block title 'Renommer la clé d’accès' %}
{% block breadcrumb %}
    {{ parent() }}
    {% do menu.addItem(key.name, url('app_user_security_passkey_edit', {uuid: key.uuid})) %}
{% endblock %}
{% block page_title 'Renommer la clé d’accès' %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            <twig:Tabler:Card>
                {{ form_start(form) }}
                <twig:Tabler:Card:Body>
                    {{ form_widget(form) }}
                </twig:Tabler:Card:Body>
                <twig:Tabler:Card:Footer class="d-flex justify-content-between">
                    <a href="{{ path('app_user_edit', {_fragment: 'security'}) }}" class="btn btn-link">Annuler</a>
                    <twig:Tabler:Button variant="primary" type="submit">Enregistrer</twig:Tabler:Button>
                </twig:Tabler:Card:Footer>
                {{ form_end(form) }}
            </twig:Tabler:Card>
        </div>
    </div>
{% endblock %}
