{% extends 'layouts/default.html.twig' %}

{% block title 'Alertes de mes sorties' %}

{% block meta_robots %}
    <meta name="robots" content="noindex, nofollow">
{% endblock %}

{% block body -%}
    <twig:Tabler:Card>
        <twig:Tabler:Empty>
            {% if unsubscribed %}
                <twig:Tabler:Empty:Icon><twig:Tabler:Icon name="lucide:bell-off" /></twig:Tabler:Empty:Icon>
                <twig:Tabler:Empty:Title>Vous ne serez plus prévenu des changements de vos sorties</twig:Tabler:Empty:Title>
                <twig:Tabler:Empty:Subtitle>
                    Vous pouvez les réactiver à tout moment depuis votre profil.
                </twig:Tabler:Empty:Subtitle>
                <twig:Tabler:Empty:Action>
                    <a class="btn" href="{{ path('app_user_edit') }}">
                        <twig:Tabler:Icon name="lucide:user" />
                        Mon profil
                    </a>
                </twig:Tabler:Empty:Action>
            {% else %}
                <twig:Tabler:Empty:Icon><twig:Tabler:Icon name="lucide:bell" /></twig:Tabler:Empty:Icon>
                <twig:Tabler:Empty:Title>Ne plus être prévenu des changements de vos sorties&nbsp;?</twig:Tabler:Empty:Title>
                <twig:Tabler:Empty:Subtitle>
                    Quand un événement où vous avez dit «&nbsp;J'y vais&nbsp;!&nbsp;» est annulé, change de dates ou de
                    lieu, nous vous l'écrivons. Vous ne recevrez plus ces e-mails.
                </twig:Tabler:Empty:Subtitle>
                <twig:Tabler:Empty:Action>
                    <form method="post" action="{{ app.request.requestUri }}">
                        <twig:Tabler:Button variant="primary" type="submit" icon="lucide:bell-off">
                            Ne plus être prévenu
                        </twig:Tabler:Button>
                    </form>
                </twig:Tabler:Empty:Action>
            {% endif %}
        </twig:Tabler:Empty>
    </twig:Tabler:Card>
{%- endblock %}
