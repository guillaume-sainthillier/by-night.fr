{% extends 'reset-password/layout.html.twig' %}

{% block reset_title 'Mot de passe oublié ?' %}
{% block reset_intro %}Pas d'inquiétude&nbsp;: saisissez l'adresse e-mail de votre compte, nous vous enverrons un lien pour choisir un nouveau mot de passe.{% endblock %}

{% block reset_body %}
    {% for flashError in app.flashes('reset_password_error') %}
        <div class="alert alert-danger" role="alert">{{ flashError }}</div>
    {% endfor %}

    {{ form_start(requestForm) }}
    {{ form_row(requestForm.email, {icon_prepend: 'lucide:at-sign', attr: requestForm.email.vars.attr|merge({placeholder: 'vous@exemple.fr'})}) }}
    <p class="small text-secondary d-flex gap-2">
        <twig:Icon name="lucide:info" class="flex-shrink-0 mt-1" />
        <span>
            {%- set lifetimeMinutes = tokenLifetime // 60 -%}
            Le lien reste valable
            {% if lifetimeMinutes % 60 == 0 -%}
                {{ '{hours, plural, one {# heure} other {# heures}}'|trans({hours: lifetimeMinutes // 60}, 'messages+intl-icu') }}.
            {%- else -%}
                {{ '{minutes, plural, one {# minute} other {# minutes}}'|trans({minutes: lifetimeMinutes}, 'messages+intl-icu') }}.
            {%- endif %}
            Pensez à regarder dans vos courriers indésirables si vous ne le recevez pas d'ici quelques minutes.
        </span>
    </p>
    <button class="btn btn-primary btn-lg w-100" type="submit">
        Envoyer le lien de réinitialisation
        <twig:Icon name="lucide:send" class="icon-end" />
    </button>
    {{ form_end(requestForm) }}
{% endblock %}
