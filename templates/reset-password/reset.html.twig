{% extends 'reset-password/layout.html.twig' %}

{% block breadcrumb_reset %}
    {% do menu.addItem('Étape 3/3', url('app_reset_password')) %}
{% endblock %}

{% block reset_icon 'lucide:key-round' %}
{% block reset_title 'Choisissez un nouveau mot de passe' %}
{% block reset_intro 'Il remplacera l\'ancien pour vous connecter à By Night.' %}

{% block reset_body %}
    {{ form_start(resetForm) }}
    {{ form_row(resetForm.plainPassword) }}
    <button class="btn btn-primary btn-lg w-100" type="submit">
        Enregistrer le mot de passe
        <twig:Icon name="lucide:check" class="icon-end" />
    </button>
    {{ form_end(resetForm) }}
{% endblock %}
