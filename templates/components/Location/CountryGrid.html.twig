{#
    The country cards of the home and country pages: the first country gets the big card, the next two are stacked
    beside it, the others follow (sideways on phones).

    <twig:Location:CountryGrid countries="{{ countries }}" />
#}
{# @var countries list<array{0: \App\Entity\Country, events: int|string, cities: list<\App\Entity\City>}> as EventRepository::findUpcomingCountries() returns them #}
{% props countries %}
{% set featured = countries|first %}
{% set beside = countries|slice(1, 2) %}
<div class="row row-cards">
    <div class="col-lg-8">
        <twig:Location:CountryCard
            country="{{ featured[0] }}"
            events="{{ featured.events }}"
            cities="{{ featured.cities|map(city => city.name) }}"
            featured="{{ true }}"
        />
    </div>
    {% if beside %}
        {# Two cards share the big card's height; a single one keeps its own, rather than stretch around blank space #}
        <div class="col-lg-4 d-flex flex-column gap-3">
            {% for row in beside %}
                <twig:Location:CountryCard
                    country="{{ row[0] }}"
                    events="{{ row.events }}"
                    cities="{{ row.cities|map(city => city.name) }}"
                    class="h-auto{{ beside|length > 1 ? ' flex-fill' }}"
                />
            {% endfor %}
        </div>
    {% endif %}
</div>
{% if countries|length > 3 %}
    <div class="row row-cards row-scroll-mobile mt-0">
        {% for row in countries|slice(3) %}
            <div class="col-10 col-sm-7 col-md-6 col-lg-4 col-xl-3">
                <twig:Location:CountryCard country="{{ row[0] }}" events="{{ row.events }}" cities="{{ row.cities|map(city => city.name) }}" />
            </div>
        {% endfor %}
    </div>
{% endif %}
