{# @var publisher \App\Entity\Publisher #}
{# @var size int the side of the picture, in pixels #}
{# The publisher's logo, else its initials #}
{% props publisher, size = 40, priority = false %}
{% if publisher.hasLogo %}
    {% set logoContext = {entity: publisher, field: 'logoFile'} %}
    <span {{ attributes.defaults({class: 'avatar', title: publisher.name}) }}>
        <twig:Picasso:Image
            loader="publisher_image"
            context="{{ logoContext }}"
            width="{{ size }}"
            height="{{ size }}"
            fit="crop"
            priority="{{ priority }}"
            alt="{{ publisher.name }}"
        />
    </span>
{% else %}
    <span {{ attributes.defaults({class: 'avatar bg-primary-lt fw-bold', title: publisher.name}) }}>
        {{- publisher.name|split(' ')|filter(word => word is not empty)|slice(0, 2)|map(word => word|first|upper)|join -}}
    </span>
{% endif %}
