{#
    A period in short French dates: "Samedi 20 juin 2026", "Du ven. 9 oct. au dim. 18 oct. 2026" (the start's year only
    when it differs from the end's). A narrow column breaks a period between its two dates, never inside one.
#}
{% props from, to = null %}
{% if to == null or from|date('Y-m-d') == to|date('Y-m-d') %}
    <time datetime="{{ from|date('Y-m-d') }}" class="text-nowrap">{{ from|format_date(pattern: 'EEEE d MMMM y', locale: 'fr')|capitalize }}</time>
{% else %}
    Du&nbsp;<time datetime="{{ from|date('Y-m-d') }}" class="text-nowrap">{{ from|format_date(pattern: from|date('Y') == to|date('Y') ? 'EEE d MMM' : 'EEE d MMM y', locale: 'fr') }}</time>
    au
    <time datetime="{{ to|date('Y-m-d') }}" class="text-nowrap">{{ to|format_date(pattern: 'EEE d MMM y', locale: 'fr') }}</time>
{% endif %}
