{# One article of a legal page: a card whose heading carries its number, with the anchor "Sur cette page" links to
   (Legal:Toc). Without a title, the card holds the text alone. #}
{% props id, title = null, number = null %}
<section {{ attributes.defaults({class: 'card legal-section', id: id}) }}>
    <div class="card-body p-4 p-lg-5">
        {% if title %}
            <h2 class="legal-section-title">
                {% if number %}
                    <span class="legal-section-number">{{ '%02d'|format(number) }}</span>
                {% endif %}
                {{ title }}
            </h2>
        {% endif %}
        <div class="legal-content">
            {% block content %}{% endblock %}
        </div>
    </div>
</section>
