{# The publisher of the site and its host, as the legal notice (LCEN art. 6) requires them: the one place they are
   written. ARNOVA's figures come from the public registry (arnova.fr's src/config/company.ts): copy them, never type
   them from memory. #}
{% props id = 'editeur' %}
<section {{ attributes.defaults({class: 'card legal-section', id: id}) }}>
    <twig:Tabler:Card:Body class="p-4 p-lg-5">
        <h2 class="legal-section-title">
            <span class="legal-section-number"><twig:Tabler:Icon name="lucide:landmark" /></span>
            Éditeur et hébergeur
        </h2>
        <twig:Tabler:Datagrid>
            <twig:Tabler:Datagrid:Item>
                <twig:Tabler:Datagrid:Item:Title>Éditeur</twig:Tabler:Datagrid:Item:Title>
                <twig:Tabler:Datagrid:Item:Content class="fw-bold">ARNOVA</twig:Tabler:Datagrid:Item:Content>
                <div class="small text-secondary">SAS au capital de 1 000 €</div>
            </twig:Tabler:Datagrid:Item>
            <twig:Tabler:Datagrid:Item>
                <twig:Tabler:Datagrid:Item:Title>Directeur de la publication</twig:Tabler:Datagrid:Item:Title>
                <twig:Tabler:Datagrid:Item:Content class="fw-bold">Guillaume Sainthillier</twig:Tabler:Datagrid:Item:Content>
            </twig:Tabler:Datagrid:Item>
            <twig:Tabler:Datagrid:Item>
                <twig:Tabler:Datagrid:Item:Title>Siège social</twig:Tabler:Datagrid:Item:Title>
                <twig:Tabler:Datagrid:Item:Content>200 rue de la Croix Nivert, 75015 Paris, France</twig:Tabler:Datagrid:Item:Content>
            </twig:Tabler:Datagrid:Item>
            <twig:Tabler:Datagrid:Item>
                <twig:Tabler:Datagrid:Item:Title>Immatriculation</twig:Tabler:Datagrid:Item:Title>
                <twig:Tabler:Datagrid:Item:Content class="font-monospace">SIRET 942 070 392 00017</twig:Tabler:Datagrid:Item:Content>
                <div class="small text-secondary">RCS Paris 942 070 392</div>
            </twig:Tabler:Datagrid:Item>
            <twig:Tabler:Datagrid:Item>
                <twig:Tabler:Datagrid:Item:Title>TVA intracommunautaire</twig:Tabler:Datagrid:Item:Title>
                <twig:Tabler:Datagrid:Item:Content class="font-monospace">FR79942070392</twig:Tabler:Datagrid:Item:Content>
            </twig:Tabler:Datagrid:Item>
            <twig:Tabler:Datagrid:Item>
                <twig:Tabler:Datagrid:Item:Title>Contact</twig:Tabler:Datagrid:Item:Title>
                <twig:Tabler:Datagrid:Item:Content>
                    <a href="https://arnova.fr" target="_blank" rel="noopener">arnova.fr</a>,
                    <a href="mailto:contact@arnova.fr">contact@arnova.fr</a>
                </twig:Tabler:Datagrid:Item:Content>
                <div class="small text-secondary">
                    Questions sur le site&nbsp;: <a href="mailto:support@by-night.fr">support@by-night.fr</a>
                </div>
            </twig:Tabler:Datagrid:Item>
        </twig:Tabler:Datagrid>
        <hr class="my-4">
        <twig:Tabler:Datagrid>
            <twig:Tabler:Datagrid:Item>
                <twig:Tabler:Datagrid:Item:Title>Hébergeur</twig:Tabler:Datagrid:Item:Title>
                <twig:Tabler:Datagrid:Item:Content>
                    <a href="https://www.ovhcloud.com" target="_blank" rel="noopener noreferrer">OVH SAS</a>, 2 rue Kellermann, 59100 Roubaix, France
                </twig:Tabler:Datagrid:Item:Content>
                <div class="small text-secondary">
                    SAS au capital de 50 000 000 €, RCS Lille Métropole 424 761 419, téléphone&nbsp;: 1007 depuis la France, +33 9 72 10 10 07 depuis l'étranger
                </div>
            </twig:Tabler:Datagrid:Item>
            <twig:Tabler:Datagrid:Item>
                <twig:Tabler:Datagrid:Item:Title>Réseau de diffusion (CDN)</twig:Tabler:Datagrid:Item:Title>
                <twig:Tabler:Datagrid:Item:Content>
                    <a href="https://www.cloudflare.com" target="_blank" rel="noopener noreferrer">Cloudflare, Inc.</a>
                </twig:Tabler:Datagrid:Item:Content>
                <div class="small text-secondary">101 Townsend Street, San Francisco, CA 94107, États-Unis</div>
            </twig:Tabler:Datagrid:Item>
        </twig:Tabler:Datagrid>
    </twig:Tabler:Card:Body>
</section>
