{# @var users iterable<\App\Entity\User> #}
{% props users, stretched = false %}

<div class="row row-cards row-deck">
    {% for i, user in users %}
        <div class="col-sm-6 col-lg-4{{ stretched ? '' : ' col-xl-3' }}">
            <twig:User:ItemCard user="{{ user }}" />
        </div>
    {% endfor %}
</div>
