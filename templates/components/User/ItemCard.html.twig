{# @var user \App\Entity\User #}
{% props user %}

<twig:Tabler:Card class="card-user card-layout mb-0">
    <div class="card-img-container">
        <div class="image-container">
            <twig:User:Thumb user="{{ user }}" width="{{ 360 }}" />
        </div>
    </div>
    <div class="card-content">
        <twig:Tabler:Card:Body>
            <h3 class="h4">
                <a href="{{ path('app_user_index', {id: user.id, slug: user.slug}) }}">
                    {{ user.username }}
                </a>
            </h3>
            <p class="card-text">
                Membre depuis le
                <span class="date text-primary">{{ user.createdAt|date('d/m/Y') }}</span>
            </p>
        </twig:Tabler:Card:Body>
        <twig:User:Socials user="{{ user }}" />
    </div>
</twig:Tabler:Card>
