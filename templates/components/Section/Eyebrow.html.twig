{# The small uppercase label above a title (Tabler's .page-pretitle, in the primary colour); "badge" puts it in a pill #}
{% props icon = null, badge = false %}
<div {{ attributes.defaults({class: badge ? 'badge bg-primary-lt mb-3' : 'page-pretitle text-primary mb-2'}) }}>
    {% if icon %}<twig:Icon name="{{ icon }}" />{% endif %}
    {% block content %}{% endblock %}
</div>
