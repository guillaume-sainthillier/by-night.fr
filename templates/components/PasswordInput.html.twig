{#
    A password input in a flat input group: a lock icon, then a button that shows or hides what was typed
    (passwordToggle() of @silarhi/app-js, assets/js/app.ts). The content is the <input type="password">, whose id
    the button controls.

    <twig:PasswordInput inputId="password"><input class="form-control" type="password" id="password" name="password" /></twig:PasswordInput>

    toggle="{{ false }}" drops the button (a confirmation field: the member compares with the first one).
#}
{% props icon = 'lucide:lock', toggle = true, inputId = null %}
<div {{ attributes.defaults({class: 'input-group input-group-flat'}) }}>
    {% if icon %}
        <span class="input-group-text text-secondary">
            <twig:Icon name="{{ icon }}" />
        </span>
    {% endif %}
    {% block content %}{% endblock %}
    {% if toggle %}
        <span class="input-group-text">
            <button class="btn btn-link link-secondary p-0" type="button" data-password-toggle aria-controls="{{ inputId }}" aria-pressed="false" aria-label="Afficher le mot de passe" title="Afficher le mot de passe" data-label-show="Afficher le mot de passe" data-label-hide="Masquer le mot de passe">
                <span data-password-toggle-icon="show"><twig:Icon name="lucide:eye" /></span>
                <span class="d-none" data-password-toggle-icon="hide"><twig:Icon name="lucide:eye-off" /></span>
            </button>
        </span>
    {% endif %}
</div>
