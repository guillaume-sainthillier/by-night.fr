{#
    A password input in a flat input group: a lock icon, then a button that shows or hides what was typed
    (assets/js/listeners/password-reveal.js). The content is the <input type="password">.

    <twig:PasswordInput><input class="form-control" type="password" name="password" /></twig:PasswordInput>

    toggle="{{ false }}" drops the button (a confirmation field: the member compares with the first one).
#}
{% props icon = 'lucide:lock', toggle = true %}
<div {{ attributes.defaults({class: 'input-group input-group-flat'}) }}>
    {% if icon %}
        <span class="input-group-text text-secondary">
            <twig:Icon name="{{ icon }}" />
        </span>
    {% endif %}
    {% block content %}{% endblock %}
    {% if toggle %}
        <span class="input-group-text">
            <button class="btn btn-link link-secondary p-0" type="button" data-password-reveal aria-pressed="false" title="Afficher le mot de passe">
                <span data-password-reveal-icon="hidden"><twig:Icon name="lucide:eye" /></span>
                <span class="d-none" data-password-reveal-icon="shown"><twig:Icon name="lucide:eye-off" /></span>
            </button>
        </span>
    {% endif %}
</div>
