{# @var event \App\Entity\Event #}
{# @var from \DateTimeInterface|null the first day of the listing (today by default) #}
{# @var to \DateTimeInterface|null its last day, when a window was searched #}
{# The picture card of the "À l'affiche" blocks and of the agenda: date and price over the picture, category, title,
   excerpt and venue. The picture box has a fixed ratio, so nothing moves when the picture loads. #}
{# @var priority bool the card opens the page: its picture is the LCP, loaded at once with a high fetch priority #}
{# @var compact bool on a phone, a row: a small picture beside the title, the date and price on a line under it and no
   excerpt, so that a long list shows several events a screen (the agenda) #}
{% props event, tone = 'primary', from = null, to = null, priority = false, compact = false %}
{# The session the visitor is looking for, not the event's overall range #}
{% set session = event.sessionFor(from, to) %}
{% set price = event.prices|price_label(event.startingPrice) %}
{% set when %}{% apply trim %}
    {%- if session %}
        {%- set lastDay = session.endAt ?? session.startAt %}
        {%- if session.startAt|date('Y-m-d') < 'now'|date('Y-m-d') %}
            Jusqu'au {{ lastDay|format_date(pattern: 'd MMM') }}
        {%- elseif lastDay|date('Y-m-d') > session.startAt|date('Y-m-d') %}
            {{ session.startAt|format_date(pattern: 'd MMM') }} – {{ lastDay|format_date(pattern: 'd MMM') }}
        {%- else %}
            {{ session.startAt|format_date(pattern: 'EEE d MMM') }}
        {%- endif %}
    {%- endif -%}
{% endapply %}{% endset %}
<article {{ attributes.defaults({class: 'card card-event card-layout h-100 mb-0' ~ (compact ? ' card-event-compact')}) }}>
    {% if event.status or event.statusMessage %}
        <twig:Event:StatusAlert event="{{ event }}" class="rounded-0 py-2 small" />
    {% endif %}
    <div class="card-img-container">
        <div class="image-container position-relative">
            <twig:Event:Thumb event="{{ event }}" width="{{ 360 }}" priority="{{ priority }}" />
            {% if session or price %}
                <div class="card-img-overlay {{ compact ? 'd-none d-md-flex' : 'd-flex' }} align-items-start justify-content-between gap-2 p-3">
                    {% if session %}
                        <span class="badge bg-white text-primary text-truncate min-w-0">
                            <twig:Icon name="lucide:calendar-days" />
                            {{- when -}}
                        </span>
                    {% endif %}
                    {% if price %}
                        <span class="badge ms-auto text-truncate {{ price.free ? 'bg-green text-white' : 'bg-white text-body' }}">{{ price.label }}</span>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
    <div class="card-content">
        <div class="card-body">
            {% if event.category %}
                <div class="subheader text-{{ tone }} mb-1">{{ event.category.name }}</div>
            {% endif %}
            <h3 class="card-title line-clamp-2 {{ compact ? 'mb-1 mb-md-2' : 'mb-2' }}">
                <a href="{{ path('app_event_details', {slug: event.slug, id: event.id, location: event.locationSlug}) }}" class="stretched-link" title="Tous les détails de {{ event.name }}">{{ event.name }}</a>
            </h3>
            {% if compact and (session or price) %}
                {# The overlay's date and price, which would hide a row's small picture #}
                <div class="d-flex flex-wrap align-items-center gap-2 small d-md-none">
                    {% if session %}
                        <span class="text-primary fw-medium"><twig:Icon name="lucide:calendar-days" /> {{ when }}</span>
                    {% endif %}
                    {% if price %}
                        <span class="{{ price.free ? 'text-green fw-medium' : 'text-body' }}">{{ price.label }}</span>
                    {% endif %}
                </div>
            {% endif %}
            {% if event.description %}
                <p class="text-secondary small line-clamp-2 mb-0{{ compact ? ' d-none d-md-block' }}">{{ event.description|excerpt(160) }}</p>
            {% endif %}
        </div>
        <div class="card-footer d-flex align-items-center justify-content-between gap-2 mt-auto">
            <span class="text-secondary small text-truncate">
                {% if event.placeName %}
                    <twig:Icon name="lucide:map-pin" />
                    {{ event.placeName }}{% if event.placeCity %}, {{ event.placeCity }}{% endif %}
                {% endif %}
            </span>
        </div>
    </div>
</article>
