{# @var event \App\Entity\Event #}
{# @var from \DateTimeInterface|null the day the listing starts from (today by default) #}
{# @var to \DateTimeInterface|null the day the listing ends, when a window was searched #}
{% props event, from = null, to = null %}

<div class="card card-event card-layout scroll-item">
    {% if event.status or event.statusMessage %}
        <twig:Event:StatusAlert event="{{ event }}" />
    {% endif %}
    <div class="card-img-container">
        {% set original = eventProfilePicture.originalPicture(event) %}
        <div class="image-container">
            <a class="image-gallery" href="{{ original }}" title="{{ event.name }}">
                <twig:Event:Thumb event="{{ event }}" width="{{ 360 }}" />
            </a>
        </div>
    </div>
    <div class="card-content">
        <div class="card-body">
            <h3 class="h5 line-clamp-2">
                <a title="Tous les détails de {{ event.name }}"
                   href="{{ path('app_event_details', {slug: event.slug, id: event.id, location: event.locationSlug}) }}">
                    <span>{{ event.name }}</span>
                </a>
            </h3>
            {# The session the visitor is looking for, not the event's overall range #}
            {% set session = event.sessionFor(from, to) %}
            {% set otherDates = event.countUpcomingSessions(from) - 1 %}
            {% if session %}
                <div class="detail-item">
                    <twig:Icon name="lucide:calendar-days" />
                    <div>
                        {% if session.endAt == null or session.startAt|date('Y-m-d') == session.endAt|date('Y-m-d') %}
                            <time datetime="{{ session.startAt|date('Y-m-d') }}">
                                {{ session.startAt|date('d/m/Y') }}
                            </time>
                        {% else %}
                            <time datetime="{{ session.startAt|date('Y-m-d') }}">
                                {{ session.startAt|date('d/m/Y') }}
                            </time>
                            -

                            <time datetime="{{ session.endAt|date('Y-m-d') }}">
                                {{ session.endAt|date('d/m/Y') }}
                            </time>
                        {% endif %}
                        <small class="text-muted">
                            {%- if session.hours %}
                                - {{ session.hours }}
                            {%- endif %}
                            {%- if otherDates > 0 %}
                                (+{{ '{count, plural, one {# autre date} other {# autres dates}}'|trans({count: otherDates}, 'messages+intl-icu') }})
                            {%- endif -%}
                        </small>
                    </div>
                </div>
            {% endif %}
            {% if event.placeName %}
                <div class="detail-item">
                    <twig:Icon name="lucide:map-pin" />
                    <div>
                        <span title="Sortir {{ event.placeName|at_place }}">
                            <strong class="font-weight-normal">{{ event.placeName }}</strong>
                        </span>
                        {% if event.placeCity %}
                            <span>,
                                <span>{{ event.placeCity }}</span>
                            </span>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
            {% if event.prices %}
                <div class="detail-item">
                    <twig:Icon name="lucide:ticket" />
                    <div>{{ event.prices }}</div>
                </div>
            {% endif %}
            {% if event.user %}
                <div class="detail-item">
                    <twig:Icon name="lucide:user" />
                    <div>
                        Par
                        <a class="one-line"
                           href="{{ path('app_user_index', {id: event.user.id, slug: event.user.slug}) }}"
                           title="Accédez au profil de {{ event.user.username }}">
                            {{ event.user.username }}
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
