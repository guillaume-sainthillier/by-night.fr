{% extends 'layouts/modal-form.html.twig' %}

{% block title -%}
    Me déconnecter de {{ service|social_label }}
{%- endblock %}

{% block form_action url %}

{% block body -%}
    <p class="lead">
        Voulez-vous vraiment vous déconnecter de {{ service|social_label }} ?
    </p>
{%- endblock %}

{% block footer -%}
    <input type="submit" class="btn btn-primary" data-loading-text="Veuillez patienter…" value="Continuer" id="disconnect_social"/>
{%- endblock %}
