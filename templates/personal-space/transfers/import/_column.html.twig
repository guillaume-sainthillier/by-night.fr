{# A column of the import's spreadsheet, in the help of the import page #}
{# @var column \App\Transfer\Sheet\EventColumn #}
<div class="py-2 border-bottom">
    <dt class="fw-bold">
        {{ column.label }}
        {% if column.required %}<span class="badge bg-red-lt ms-1">obligatoire</span>{% endif %}
    </dt>
    <dd class="text-secondary small mb-0">{{ column.help }}</dd>
</div>
