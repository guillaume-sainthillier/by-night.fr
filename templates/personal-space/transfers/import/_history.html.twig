{# The member's latest imports (ImportController::history()), read again when one of them changes #}
{# @var imports \App\Entity\EventImport[] #}
<twig:Tabler:Card>
    <twig:Tabler:Card:Header>
        <twig:Tabler:Card:Title>Vos derniers imports</twig:Tabler:Card:Title>
    </twig:Tabler:Card:Header>
    {% if imports is empty %}
        <twig:Tabler:Card:Body class="text-secondary">Aucun import pour l’instant&nbsp;: votre premier fichier apparaîtra ici, avec son bilan.</twig:Tabler:Card:Body>
    {% else %}
        <twig:Tabler:ListGroup flush>
            {% for import in imports %}
                {{ include('personal-space/transfers/import/_row.html.twig') }}
            {% endfor %}
        </twig:Tabler:ListGroup>
    {% endif %}
</twig:Tabler:Card>
