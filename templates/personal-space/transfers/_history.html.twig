{# The member's latest imports and exports (TransferController::history()), read again when one of them changes #}
{# @var imports \App\Entity\EventImport[] #}
{# @var exports \App\Entity\EventExport[] #}
<div class="row row-cards">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Imports</h3>
            </div>
            {% if imports is empty %}
                <div class="card-body text-secondary">Aucun import pour l’instant.</div>
            {% else %}
                <div class="list-group list-group-flush">
                    {% for import in imports %}
                        {{ include('personal-space/transfers/import/_row.html.twig') }}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Exports</h3>
            </div>
            {% if exports is empty %}
                <div class="card-body text-secondary">Aucun export pour l’instant.</div>
            {% else %}
                <div class="list-group list-group-flush">
                    {% for export in exports %}
                        {{ include('personal-space/transfers/export/_row.html.twig') }}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
