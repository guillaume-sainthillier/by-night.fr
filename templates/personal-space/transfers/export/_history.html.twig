{# The member's latest exports (ExportController::history()), read again when one of them changes #}
{# @var exports \App\Entity\EventExport[] #}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">Vos derniers exports</h3>
    </div>
    {% if exports is empty %}
        <div class="card-body text-secondary">Aucun export pour l’instant&nbsp;: vos fichiers apparaîtront ici, prêts à télécharger.</div>
    {% else %}
        <div class="list-group list-group-flush">
            {% for export in exports %}
                {{ include('personal-space/transfers/export/_row.html.twig') }}
            {% endfor %}
        </div>
    {% endif %}
</div>
