{# The member's latest exports (ExportController::history()), read again when one of them changes #}
{# @var exports \App\Entity\EventExport[] #}
<twig:Tabler:Card>
    <twig:Tabler:Card:Header>
        <twig:Tabler:Card:Title>Vos derniers exports</twig:Tabler:Card:Title>
    </twig:Tabler:Card:Header>
    {% if exports is empty %}
        <twig:Tabler:Card:Body class="text-secondary">Aucun export pour l’instant&nbsp;: vos fichiers apparaîtront ici, prêts à télécharger.</twig:Tabler:Card:Body>
    {% else %}
        <twig:Tabler:ListGroup flush>
            {% for export in exports %}
                {{ include('personal-space/transfers/export/_row.html.twig') }}
            {% endfor %}
        </twig:Tabler:ListGroup>
    {% endif %}
</twig:Tabler:Card>
