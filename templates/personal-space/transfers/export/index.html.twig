{% extends 'personal-space/layout.html.twig' %}

{# @var form \Symfony\Component\Form\FormView #}

{% block title 'Exporter mes événements' %}
{% block page_title 'Exporter vos événements' %}

{% block breadcrumb_personal_space -%}
    {% do menu.addItem('Exporter', url('app_event_exports')) %}
{%- endblock %}

{% block layout_top %}
    {{ include('layouts/_flash-messages.html.twig', {container_class: block('container_class')}) }}
    {{ block('layout_header') }}
{% endblock %}

{% block body -%}
    {# The member's channel: each export of theirs tells the page when it changes (TransferNotifier) #}
    <div {{ load_page('event_transfers', {hub: mercure(user_channel(app.user), {subscribe: user_channel(app.user)}), refreshUrl: path('app_event_exports_history')}) }}>
        <section class="row justify-content-center text-center pt-lg-3 mb-4">
            <div class="col-lg-8">
                <twig:Section:Eyebrow icon="lucide:download" badge="{{ true }}">Espace organisateur</twig:Section:Eyebrow>
                <h1 class="display-6 fw-bold mb-3">{{ block('page_title') }}</h1>
                <p class="lead text-secondary mb-4">
                    Récupérez vos événements dans un tableur ou votre agenda. Modifiés puis importés à nouveau, ils sont mis à jour, jamais publiés deux fois.
                </p>
                {{ include('personal-space/transfers/_nav.html.twig', {active: 'export'}) }}
            </div>
        </section>

        <div class="row row-cards">
            <div class="col-lg-5">
                <twig:FormCard icon="lucide:download" tone="blue" title="Nouvel export" description="Prêt en quelques instants, ci-contre.">
                    {{ form_start(form) }}
                    {{ form_row(form.scope) }}
                    {{ form_row(form.format) }}
                    <button type="submit" class="btn btn-primary">
                        <twig:Icon name="lucide:download" />
                        Exporter
                    </button>
                    {{ form_end(form) }}
                </twig:FormCard>

                <div class="card mt-3">
                    <div class="card-body d-flex align-items-start gap-3">
                        <span class="avatar bg-teal-lt flex-shrink-0"><twig:Icon name="lucide:repeat" /></span>
                        <div class="text-secondary small">
                            Un export Excel ou CSV a les colonnes de l’import&nbsp;: changez-y vos événements, puis
                            <a href="{{ path('app_event_imports') }}">importez le fichier</a>. Le calendrier (ICS) s’ajoute à votre agenda, il ne s’importe pas.
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7" id="historique" data-transfer-refresh>
                {{ include('personal-space/transfers/export/_history.html.twig') }}
            </div>
        </div>
    </div>
{%- endblock %}

{% block js -%}
    {{ reprise_entry_script_tags('event_transfers') }}
{%- endblock %}
