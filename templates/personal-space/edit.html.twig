{% extends 'personal-space/new.html.twig' %}

{% block title event.name %}
{% block page_title event.name %}
{% block page_description 'Modifiez les informations de votre événement.' %}

{% block breadcrumb_personal_space -%}
    {% do menu.addItem(event.name, url('app_event_edit', {id: event.id})) %}
{%- endblock %}

{% block page_actions %}
    <div class="col-md-auto">
        {% if event.draft %}
            <twig:Tabler:Badge variant="secondary" light>Brouillon</twig:Tabler:Badge>
        {% else %}
            <twig:Tabler:Badge variant="" class="bg-teal-lt">En ligne</twig:Tabler:Badge>
        {% endif %}
    </div>
{% endblock %}

{% block form_actions_extra %}
    <twig:Tabler:Dropdown direction="up">
        <twig:Tabler:Button variant="secondary" appearance="ghost" iconOnly type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Plus d'actions" title="Plus d'actions">
            <twig:Tabler:Icon name="lucide:ellipsis-vertical" />
        </twig:Tabler:Button>
        <twig:Tabler:Dropdown:Menu end>
            <twig:Tabler:Dropdown:Item icon="lucide:eye" href="{{ path('app_event_details', {slug: event.slug, id: event.id, location: event.locationSlug}) }}">
                Voir l'événement
            </twig:Tabler:Dropdown:Item>
            <twig:Tabler:Dropdown:Item icon="lucide:chart-column" href="{{ path('app_event_stats', {id: event.id}) }}">
                Statistiques
            </twig:Tabler:Dropdown:Item>
            <twig:Tabler:Dropdown:Divider />
            {# Submits the delete form below, which cannot be nested in the event form #}
            <twig:Tabler:Dropdown:Item tag="button" icon="lucide:trash-2" type="submit" form="event-delete-form" class="text-danger">
                Supprimer l'événement
            </twig:Tabler:Dropdown:Item>
        </twig:Tabler:Dropdown:Menu>
    </twig:Tabler:Dropdown>
{% endblock %}

{# Only a draft goes online: a published event was already checked, or comes from a source #}
{% block duplicates_url event.draft ? path('app_event_edit_duplicates', {id: event.id}) : '' %}

{# A draft is put online by the main button, a published event stays online #}
{% block form_submit %}
    {% if event.draft %}
        {{ parent() }}
    {% else %}
        <twig:Tabler:Button variant="primary" size="lg" type="submit">
            <twig:Tabler:Icon name="lucide:save" />
            Enregistrer
        </twig:Tabler:Button>
    {% endif %}
{% endblock %}

{% block body_form %}
    {{ parent() }}
    <form id="event-delete-form"
          method="post"
          action="{{ path('app_event_delete', {id: event.id}) }}"
          data-confirm-title="{{ 'Supprimer cet événement ?'|trans }}"
          data-confirm-message="{{ 'Cette action va supprimer « {name} » ainsi que toutes les données rattachées.'|trans({name: event.name}, 'messages+intl-icu') }}"
          data-confirm-button="{{ 'Supprimer'|trans }}">
        <input name="_method" type="hidden" value="DELETE">
        <input name="_token" type="hidden" value="{{ csrf_token('delete-event-' ~ event.id) }}">
    </form>
{% endblock %}
