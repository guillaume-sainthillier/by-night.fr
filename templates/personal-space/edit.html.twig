{% extends 'personal-space/new.html.twig' %}

{% block title event.name %}
{% block page_title event.name %}
{% block page_description 'Modifiez les informations de votre événement.' %}

{% block breadcrumb_personal_space -%}
    {% do menu.addItem(event.name, url('app_event_edit', {id: event.id})) %}
{%- endblock %}

{% block page_actions %}
    <div class="col-md-auto">
        {% if event.draft %}
            <span class="badge bg-secondary-lt">Brouillon</span>
        {% else %}
            <span class="badge bg-teal-lt">En ligne</span>
        {% endif %}
    </div>
{% endblock %}

{% block form_actions_extra %}
    <div class="dropdown dropup">
        <button type="button" class="btn btn-icon btn-ghost-secondary" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Plus d'actions" title="Plus d'actions">
            <twig:Icon name="lucide:ellipsis-vertical" />
        </button>
        <div class="dropdown-menu dropdown-menu-end">
            <a class="dropdown-item" href="{{ path('app_event_details', {slug: event.slug, id: event.id, location: event.locationSlug}) }}">
                <twig:Icon name="lucide:eye" class="dropdown-item-icon" />
                Voir l'événement
            </a>
            <div class="dropdown-divider"></div>
            {# Submits the delete form below, which cannot be nested in the event form #}
            <button type="submit" form="event-delete-form" class="dropdown-item text-danger">
                <twig:Icon name="lucide:trash-2" class="dropdown-item-icon" />
                Supprimer l'événement
            </button>
        </div>
    </div>
{% endblock %}

{# A draft is put online by the main button, a published event stays online #}
{% block form_submit %}
    {% if event.draft %}
        {{ parent() }}
    {% else %}
        <button type="submit" class="btn btn-lg btn-primary">
            <twig:Icon name="lucide:save" />
            Enregistrer
        </button>
    {% endif %}
{% endblock %}

{% block body_form %}
    {{ parent() }}
    <form id="event-delete-form"
          method="post"
          action="{{ path('app_event_delete', {id: event.id}) }}"
          data-confirm-title="{{ 'Supprimer cet événement ?'|trans }}"
          data-confirm-message="{{ 'Cette action va supprimer « {name} » ainsi que toutes les données rattachées.'|trans({name: event.name}, 'messages+intl-icu') }}"
          data-confirm-button="{{ 'Supprimer'|trans }}">
        <input name="_method" type="hidden" value="DELETE">
        <input name="_token" type="hidden" value="{{ csrf_token('delete-event-' ~ event.id) }}">
    </form>
{% endblock %}
