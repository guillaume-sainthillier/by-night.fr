{% use 'form/fields.html.twig' %}

{#
    Theme of the event form (personal space). A date of the event is a row: its calendar leaf, its date picker and its
    own hours, which fall back on the event's hours (their placeholder) and say so in a badge. The rows keep the classes
    of the other collections (.collection-item, .remove-collection) that the collection manager and the date generator
    look for.
#}
{%- block _app_event_timesheets_widget -%}
    {% set default_hours = form.parent.children.hours.vars.value ?: 'À 20h, de 21h à minuit' %}
    {% if prototype is defined and not prototype.rendered %}
        {% set child = prototype %}
        {% set attr = attr|merge({
            'data-prototype': block('event_timesheet_item'),
            'data-prototype-name': prototype.vars.name,
        }) %}
    {% endif %}
    <div {{ block('widget_container_attributes') }}>
        {% for child in form|filter(child => not child.rendered) %}
            {{- block('event_timesheet_item') -}}
        {% endfor %}
        {{- form_rest(form) -}}
    </div>
{%- endblock -%}

{%- block event_timesheet_item -%}
    <div class="collection-item timesheet-item card card-sm mb-2">
        <div class="card-body">
            {# One line from md, two on phones (leaf and date, then hours and delete): bottom-aligned, the button
               lines up with the fields #}
            <div class="row g-3 align-items-end">
                <div class="col-auto">
                    <twig:Event:DateBlock date="{{ child.dateRange.from.vars.data }}" data-timesheet-leaf />
                </div>
                <div class="col col-md-4">
                    {{ form_row(child.dateRange, {label: 'Date', row_class: 'mb-0'}) }}
                </div>
                <div class="w-100 d-md-none"></div>
                <div class="col">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        {{ form_label(child.hours, 'Horaires', {label_attr: {class: 'mb-0'}}) }}
                        <span class="badge bg-secondary-lt timesheet-hours-default">Par défaut</span>
                        <span class="badge bg-teal-lt timesheet-hours-own">Personnalisés</span>
                    </div>
                    <twig:InputIcon iconPrepend="lucide:clock">
                        {{ form_widget(child.hours, {attr: child.hours.vars.attr|merge({placeholder: default_hours})}) }}
                    </twig:InputIcon>
                    {{ form_errors(child.hours) }}
                </div>
                {% if not disabled and allow_delete %}
                    <div class="col-auto">
                        <button class="btn btn-icon btn-ghost-danger remove-collection" data-item=".collection-item" type="button" data-confirm-message="Supprimer cette date&nbsp;?" data-bs-toggle="tooltip" title="Supprimer cette date">
                            <twig:Icon name="lucide:trash-2" />
                        </button>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{%- endblock -%}
