{% extends 'personal-space/layout.html.twig' %}

{% block title 'Mes événements' %}
{% block page_title 'Mes événements' %}

{% block title_after %}
    {% if is_granted(constant('\\App\\Security\\Voter\\EventVoter::CREATE')) %}
        <div class="text-center mt-2">
            <a class="btn btn-success" href="{{ path('app_event_new') }}">
                <twig:Icon name="lucide:plus" />
                Nouvel événement
            </a>
        </div>
    {% endif %}
{% endblock %}

{% block body -%}
    <div class="card" {{ load_page('personal_space_list') }}>
        <div class="card-header">
            <form method="GET" action="{{ path('app_event_list') }}" class="w-100">
                <twig:InputIcon iconPrepend="lucide:search">
                    <input name="q" type="search" class="form-control" placeholder="{{ 'Rechercher un événement…'|trans }}" value="{{ q }}">
                </twig:InputIcon>
            </form>
        </div>
        {% if events|length > 0 %}
            <div class="table-responsive">
                <table class="table card-table align-middle mb-0">
                    <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Lieu</th>
                        <th>Ville</th>
                        <th>Date</th>
                        <th>Visible</th>
                        <th>Annulé</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for event in events %}
                        <tr>
                            <td>
                                <a href="{{ path('app_event_edit', {id: event.id}) }}" title="Accéder à l'événement">{{ event.name }}</a>
                            </td>
                            <td>{{ event.placeName }}</td>
                            <td>{{ event.placeCity }}</td>
                            <td>
                                <twig:Dates from="{{ event.startDate }}" to="{{ event.endDate }}" />
                            </td>
                            <td>
                                <div class="form-check form-switch">
                                    <input class="form-check-input draft" data-href="{{ path('api_event_draft', {id: event.id}) }}" type="checkbox" {{ not event.draft ? 'checked' }} id="draft-event-{{ event.id }}">
                                    <label class="form-check-label" for="draft-event-{{ event.id }}">&nbsp;</label>
                                </div>
                            </td>
                            <td>
                                <div class="form-check form-switch">
                                    <input class="form-check-input cancel" data-href="{{ path('api_event_cancel', {id: event.id}) }}" type="checkbox" {{ event.status and event.status == enum('App\\Enum\\EventStatus').Cancelled ? 'checked' }} id="cancel-event-{{ event.id }}">
                                    <label class="form-check-label" for="cancel-event-{{ event.id }}">&nbsp;</label>
                                </div>
                            </td>
                            <td class="actions">
                                <div class="btn-group btn-group-icon-sm">
                                    <a class="btn btn-icon" href="{{ path('app_event_details', {slug: event.slug, id: event.id, location: event.locationSlug}) }}" data-bs-toggle="tooltip" title="Voir l'événement">
                                        <twig:Icon name="lucide:eye" class="text-secondary" />
                                    </a>
                                    <a class="btn btn-icon" href="{{ path('app_event_edit', {id: event.id}) }}" data-bs-toggle="tooltip" title="Corriger l'événement">
                                        <twig:Icon name="lucide:pencil" class="text-primary" />
                                    </a>
                                    <button type="button" class="btn btn-icon" data-target=".form-delete-{{ event.id }}" data-bs-toggle="tooltip" title="Supprimer l'événement">
                                        <twig:Icon name="lucide:trash-2" class="text-danger" />
                                    </button>
                                </div>
                                <form class="d-none form-delete-{{ event.id }}" method="post" action="{{ path('app_event_delete', {id: event.id}) }}">
                                    <input name="_method" type="hidden" value="DELETE">
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if events.nbPages > 1 %}
                <div class="card-footer d-flex align-items-center">
                    {{ pagerfanta(events) }}
                </div>
            {% endif %}
        {% else %}
            <div class="card-body">
                <p class="text-secondary mb-0">
                    {% if q %}
                        {{ 'Aucun événement trouvé pour votre recherche.'|trans }}
                    {% else %}
                        {{ "Vous n'avez pas encore créé d'événement. Publiez le vôtre dès maintenant !"|trans }}
                    {% endif %}
                </p>
            </div>
        {% endif %}
    </div>
{%- endblock %}

{% block css -%}
    {{ reprise_entry_link_tags('personal_space_list') }}
{%- endblock %}

{% block js -%}
    {{ reprise_entry_script_tags('personal_space_list') }}
{%- endblock %}
