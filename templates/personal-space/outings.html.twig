{% extends 'layouts/default.html.twig' %}

{% block title 'Mes sorties' %}

{% block breadcrumb %}
    {% do menu.addItem('Mes sorties', url('app_outing_list')) %}
{% endblock %}

{% block body -%}
    {% set city = app_context.city %}
    <p class="lead text-secondary mb-4">
        Les événements où vous avez dit «&nbsp;J'y vais&nbsp;!&nbsp;», du plus proche au plus lointain.
    </p>

    {% if outings.nbResults > 0 %}
        <div class="row row-cards" id="outings">
            {% for event in outings %}
                <div class="col-md-6 col-xl-4">
                    <twig:Event:Card event="{{ event }}" priority="{{ loop.first }}" />
                </div>
            {% endfor %}
        </div>

        {% if outings.haveToPaginate %}
            <div class="d-flex justify-content-center mt-4">
                {{ pagerfanta(outings, {omitFirstPage: true, proximity: 1}) }}
            </div>
        {% endif %}
    {% else %}
        <div class="card">
            <div class="empty">
                <div class="empty-icon"><twig:Icon name="lucide:heart" /></div>
                <p class="empty-title">Aucune sortie prévue pour l'instant</p>
                <p class="empty-subtitle text-secondary">
                    Sur la page d'un événement, «&nbsp;J'y vais&nbsp;!&nbsp;» l'ajoute ici&nbsp;: vous le retrouvez le jour venu.
                </p>
                <div class="empty-action">
                    {% if city %}
                        <a class="btn btn-primary" href="{{ path('app_location_index', {location: city.slug}) }}">
                            <twig:Icon name="lucide:calendar-days" />
                            Que faire {{ city.name|at_place }}&nbsp;?
                        </a>
                    {% else %}
                        <a class="btn btn-primary" href="{{ path('app_index') }}">
                            <twig:Icon name="lucide:map-pin" />
                            Choisir une ville
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endif %}

    {% if pastCount > 0 %}
        <p class="text-secondary mt-4 mb-0">
            <twig:Icon name="lucide:history" />
            {{ '{count, plural, one {Votre sortie passée reste} other {Vos # sorties passées restent}}'|trans({count: pastCount}, 'messages+intl-icu') }}
            sur <a href="{{ path('app_user_index', {id: app.user.id, slug: app.user.slug, _fragment: 'passes'}) }}">votre profil public</a>.
        </p>
    {% endif %}

    {# The outings as a calendar the member's app subscribes to (OutingCalendarController): it follows their changes #}
    {% set webcalUrl = 'webcal://' ~ calendarUrl|split('://', 2)|last %}
    <div class="card mt-4" id="calendrier">
        <div class="card-body">
            <h2 class="h3 text-start mb-2">
                <twig:Icon name="lucide:calendar-sync" />
                Ajouter à mon calendrier
            </h2>
            <p class="text-secondary">
                Vos sorties s'ajoutent à votre agenda et le suivent&nbsp;: un nouveau «&nbsp;J'y vais&nbsp;!&nbsp;», une date
                qui change ou un événement annulé s'y retrouvent d'eux-mêmes.
            </p>
            <div class="btn-list mb-3">
                <a class="btn btn-primary" href="https://calendar.google.com/calendar/render?cid={{ webcalUrl|url_encode }}" target="_blank" rel="noopener noreferrer">
                    <twig:Icon name="lucide:calendar-plus" />
                    Google Agenda
                </a>
                <a class="btn" href="{{ webcalUrl }}">
                    <twig:Icon name="lucide:calendar-plus" />
                    Apple Calendrier
                </a>
                <a class="btn" href="https://outlook.live.com/calendar/0/addfromweb?url={{ calendarUrl|url_encode }}&amp;name={{ 'Mes sorties By Night'|url_encode }}" target="_blank" rel="noopener noreferrer">
                    <twig:Icon name="lucide:calendar-plus" />
                    Outlook
                </a>
            </div>
            <label class="form-label" for="calendar-url">Ou copiez l'adresse dans votre application de calendrier</label>
            <div class="input-group mb-2">
                <input class="form-control" id="calendar-url" type="text" value="{{ calendarUrl }}" readonly>
                <button type="button" class="btn" data-copy-url="{{ calendarUrl }}">
                    <twig:Icon name="lucide:copy" />
                    Copier
                </button>
            </div>
            <p class="text-secondary small mb-0">
                Cette adresse est personnelle&nbsp;: qui la connaît voit vos sorties. Partagée par erreur&nbsp;?
            </p>
            <form method="post" action="{{ path('app_outing_calendar_renew') }}" class="d-inline" data-confirm-message="Les calendriers abonnés à l'adresse actuelle ne recevront plus vos sorties." data-confirm-title="Changer d'adresse&nbsp;?" data-confirm-button="Changer l'adresse">
                <input type="hidden" name="_token" value="{{ csrf_token(renewCalendarToken) }}">
                <button type="submit" class="btn btn-link btn-sm px-0">Changer l'adresse</button>
            </form>
        </div>
    </div>
{%- endblock %}
