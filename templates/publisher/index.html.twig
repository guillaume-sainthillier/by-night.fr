{% extends 'layouts/default.html.twig' %}

{% set name = publisher.name %}
{% set owner = publisher.owner %}
{% set stats = profile.stats %}
{% set eventsCount = stats.events %}
{% set websiteUrl = publisher.website|ensure_protocol %}

{% block body_id 'page-publisher' %}
{% block title name %}

{% block breadcrumb %}
    {% do menu.addItem(name, url('app_publisher_index', {slug: publisher.slug})) %}
{% endblock %}

{% block meta_description -%}
    {% if publisher.description %}
        {{- publisher.description|u.truncate(155, '…', false) -}}
    {% else %}
        Les événements de {{ name }} sur By Night&nbsp;: {{ '{count, plural, =0 {aucun à venir} other {# à venir}}'|trans({count: stats.upcomingEvents}, 'messages+intl-icu') }}, {{ '{count, plural, one {# événement publié} other {# événements publiés}}'|trans({count: eventsCount}, 'messages+intl-icu') }}{% if stats.firstYear %} depuis {{ stats.firstYear }}{% endif %}.
    {%- endif %}
{%- endblock %}

{% block meta_robots %}
    {% if eventsCount == 0 %}
        <meta name="robots" content="noindex, follow">
    {% endif %}
{% endblock %}

{# The cover and the publisher's name open the page, above the two columns (see body) #}
{% block layout_top %}
    {{ include('layouts/_flash-messages.html.twig', {container_class: block('container_class')}) }}
{% endblock %}

{% block body -%}
    {# Its own members only: an administrator may edit it too, but has nothing to complete #}
    {% set canEdit = app.user and publisher.managedBy(app.user) %}

    {% if publisher.hasCover %}
        {% set coverContext = {entity: publisher, field: 'coverFile'} %}
        <div class="publisher-cover rounded-3 overflow-hidden mt-3">
            <twig:Picasso:Image
                loader="publisher_image"
                context="{{ coverContext }}"
                width="{{ 1600 }}"
                height="{{ 400 }}"
                fit="crop"
                sizes="(min-width: 1200px) 1200px, 100vw"
                priority="{{ true }}"
                alt=""
            />
        </div>
    {% endif %}

    <header class="text-center my-4">
        <h1 class="display-5 fw-bold mb-0">{{ name }}</h1>
        <div class="member-title-accent mx-auto mt-2"></div>
        {% if publisher.description %}
            <div class="row justify-content-center mt-3">
                <p class="col-md-8 col-lg-6 text-secondary publisher-description mb-0">{{ publisher.description }}</p>
            </div>
        {% endif %}
    </header>

    <div class="row" {{ load_page('user') }}>
        {# The publisher: who it is, its links, how long it has published, who runs it #}
        <aside class="col-lg-4">
            {% if canEdit %}
                {% set editUrl = path('app_publisher_edit', {publisher: publisher.slug}) %}
                <twig:Publisher:Completion completion="{{ profile.completion }}" editUrl="{{ editUrl }}" />
            {% endif %}

            <div class="card">
                <div class="card-body text-center">
                    <twig:Publisher:Avatar publisher="{{ publisher }}" size="{{ 176 }}" priority="{{ true }}" class="avatar-4xl rounded-3 mb-3" />
                    <div class="h2 mb-0">{{ name }}</div>
                    <span class="badge bg-primary-lt text-uppercase mt-2">Organisateur</span>
                </div>
                {% if websiteUrl %}
                    <div class="card-body d-flex align-items-center justify-content-center gap-2 text-secondary">
                        <twig:Icon name="lucide:globe" class="text-primary flex-shrink-0" />
                        <a class="text-truncate" href="{{ websiteUrl }}" rel="nofollow ugc noopener" target="_blank">
                            {{- publisher.website|u.trimPrefix(['https://', 'http://']).trimPrefix('www.').trimSuffix('/') -}}
                        </a>
                    </div>
                {% endif %}
                {% if publisher.networkLinks %}
                    <div class="card-body">
                        <twig:Publisher:Links publisher="{{ publisher }}" withWebsite="{{ false }}" class="justify-content-center" />
                    </div>
                {% endif %}
                <div class="card-body d-flex align-items-center justify-content-between gap-2">
                    <span class="text-secondary">
                        <twig:Icon name="lucide:calendar-days" />
                        {{ stats.firstYear ? 'Publie depuis' : 'Sur By Night depuis' }}
                    </span>
                    <span class="badge bg-secondary-lt">{{ stats.firstYear ?: publisher.createdAt|date('Y') }}</span>
                </div>
                {% if owner %}
                    <div class="card-body pb-2">
                        <div class="subheader">Géré par</div>
                    </div>
                    <div class="list-group list-group-flush">
                        <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="{{ path('app_user_index', {id: owner.id, slug: owner.slug}) }}" title="Le profil de {{ owner.username }}">
                            <span class="avatar">
                                <twig:User:Thumb user="{{ owner }}" width="{{ 40 }}" height="{{ 40 }}" />
                            </span>
                            <strong class="text-truncate">{{ owner.username }}</strong>
                        </a>
                    </div>
                {% endif %}
            </div>

            {% if profile.distinctions %}
                <div class="card">
                    <div class="card-body">
                        <div class="subheader mb-2">Distinctions</div>
                        <div class="d-flex flex-wrap gap-2">
                            {% for distinction in profile.distinctions %}
                                <span class="badge bg-{{ distinction.tone }}-lt" title="{{ distinction.description }}">
                                    <twig:Icon name="{{ distinction.icon }}" />
                                    <span class="text-body">{{ distinction.label }}</span>
                                </span>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endif %}
        </aside>

        <div class="col-lg-8">
            {# What its events add up to #}
            {% set figures = [
                {label: '{count, plural, one {événement} other {événements}}'|trans({count: eventsCount}, 'messages+intl-icu'), value: eventsCount, icon: 'lucide:calendar-days', tone: 'primary'},
                {label: 'à venir', value: stats.upcomingEvents, icon: 'lucide:calendar-clock', tone: 'teal'},
                {label: 'J\'y vais et favoris', value: stats.audience, icon: 'lucide:heart', tone: 'pink'},
                {label: '{count, plural, one {ville} other {villes}}'|trans({count: stats.cities}, 'messages+intl-icu'), value: stats.cities, icon: 'lucide:map', tone: 'blue'},
            ] %}
            <div class="row row-cards mb-3">
                {% for figure in figures %}
                    <div class="col-6 col-xl-3">
                        <div class="card card-sm mb-0 h-100">
                            <div class="card-body d-flex align-items-center gap-3">
                                <span class="avatar bg-{{ figure.tone }}-lt flex-shrink-0">
                                    <twig:Icon name="{{ figure.icon }}" />
                                </span>
                                <div class="min-w-0">
                                    <div class="h2 mb-0">{{ figure.value|format_number() }}</div>
                                    <div class="small text-secondary lh-sm">{{ figure.label }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            {# The publisher's events online #}
            <twig:FormCard>
                <twig:block name="header">
                    <twig:FormCard:Header class="flex-wrap" icon="lucide:calendar-days" title="Événements" description="{{ 'Les événements publiés par ' ~ name }}">
                        <twig:block name="aside">
                            <nav class="nav nav-segmented ms-auto" role="tablist">
                                <a class="nav-link active" id="a-venir-tab" href="#a-venir" data-bs-toggle="tab" role="tab" aria-controls="a-venir" aria-selected="true">
                                    À venir
                                    {% if nextEvents.nbResults > 0 %}
                                        <span class="badge bg-primary-lt ms-1">{{ nextEvents.nbResults }}</span>
                                    {% endif %}
                                </a>
                                <a class="nav-link" id="passes-tab" href="#passes" data-bs-toggle="tab" role="tab" aria-controls="passes" aria-selected="false">
                                    {{ '{count, plural, one {Passé} other {Passés}}'|trans({count: previousEvents.nbResults}, 'messages+intl-icu') }}
                                    {% if previousEvents.nbResults > 0 %}
                                        <span class="badge bg-primary-lt ms-1">{{ previousEvents.nbResults }}</span>
                                    {% endif %}
                                </a>
                            </nav>
                        </twig:block>
                    </twig:FormCard:Header>
                </twig:block>

                <div class="tab-content">
                    <div class="tab-pane active" id="a-venir" role="tabpanel" aria-labelledby="a-venir-tab">
                        {% if nextEvents.nbResults == 0 %}
                            <div class="alert alert-info mb-0" role="status">
                                <div class="d-flex gap-3">
                                    <twig:Icon name="lucide:info" class="alert-icon" />
                                    <div>
                                        <div class="fw-bold">Aucun événement à venir</div>
                                        {{ name }} n'a pas d'événement programmé pour le moment.
                                        {% if canEdit %}
                                            <a href="{{ path('app_event_new', {publisher: publisher.slug}) }}">Publier un événement</a>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <div class="user-events-container" data-type="next">
                                {{ include('publisher/events_list.html.twig', {events: nextEvents, publisher: publisher, isNext: true}) }}
                            </div>
                        {% endif %}
                    </div>
                    <div class="tab-pane" id="passes" role="tabpanel" aria-labelledby="passes-tab">
                        {% if previousEvents.nbResults == 0 %}
                            <div class="alert alert-info mb-0" role="status">
                                <div class="d-flex gap-3">
                                    <twig:Icon name="lucide:info" class="alert-icon" />
                                    <div>
                                        <div class="fw-bold">Aucun événement passé</div>
                                        {{ name }} n'a pas encore d'événement passé.
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <div class="user-events-container" data-type="previous">
                                {{ include('publisher/events_list.html.twig', {events: previousEvents, publisher: publisher, isNext: false}) }}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </twig:FormCard>

            {# Where and what: the venues, the cities and the categories of its events #}
            {% if profile.places or profile.categories %}
                <div class="row row-cards">
                    {% if profile.places %}
                        <div class="col-md-6">
                            <twig:FormCard icon="lucide:landmark" title="Ses lieux" description="Où se tiennent ses événements" class="h-100">
                                {% for place in profile.places %}
                                    <div class="form-panel rounded position-relative d-flex align-items-center gap-3 p-3 mb-2">
                                        <span class="avatar avatar-sm rounded-circle flex-shrink-0 {{ loop.index0 < 2 ? ['bg-primary', 'bg-teal'][loop.index0] ~ ' text-white' : 'bg-secondary-lt' }}">{{ loop.index }}</span>
                                        <div class="flex-fill min-w-0">
                                            <a class="stretched-link text-reset fw-bold d-block text-truncate" href="{{ path('app_agenda_by_place', {location: place.locationSlug, placeSlug: place.slug}) }}">{{ place.name }}</a>
                                            {% if place.cityName %}
                                                <div class="small text-secondary text-truncate">{{ place.cityName }}</div>
                                            {% endif %}
                                        </div>
                                        <div class="text-end flex-shrink-0">
                                            <div class="h3 mb-0">{{ place.events }}</div>
                                            <div class="subheader">{{ '{count, plural, one {événement} other {événements}}'|trans({count: place.events}, 'messages+intl-icu') }}</div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </twig:FormCard>
                        </div>
                    {% endif %}
                    {% if profile.categories %}
                        {% set categoryEvents = profile.categories|reduce((sum, category) => sum + category.events, 0) %}
                        <div class="col-md-6">
                            <twig:FormCard icon="lucide:shapes" title="Sa programmation" description="Les catégories de ses événements" class="h-100">
                                {% for category in profile.categories %}
                                    {% set share = (category.events * 100 / categoryEvents)|round %}
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between gap-2 fw-bold">
                                            <span>{{ category.name|capitalize }}</span>
                                            <span class="text-nowrap">{{ category.events }} ({{ share }}&nbsp;%)</span>
                                        </div>
                                        <div class="progress progress-sm mt-1">
                                            <div class="progress-bar {{ ['bg-primary', 'bg-teal', 'bg-yellow', 'bg-pink', 'bg-blue'][loop.index0] }}" style="width: {{ share }}%" role="progressbar" aria-valuenow="{{ share }}" aria-valuemin="0" aria-valuemax="100" aria-label="{{ share }}&nbsp;% de ses événements en {{ category.name|lower }}"></div>
                                        </div>
                                    </div>
                                {% endfor %}
                                {% if profile.cities %}
                                    <div class="subheader mt-3 mb-2">Ses villes</div>
                                    <div class="d-flex flex-wrap gap-2">
                                        {% for city in profile.cities %}
                                            <a class="badge bg-secondary-lt" href="{{ path('app_location_index', {location: city.slug}) }}">{{ city.name }} · {{ city.events }}</a>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </twig:FormCard>
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
{%- endblock %}

{% block css -%}
    {{ reprise_entry_link_tags('user') }}
{%- endblock %}

{% block js -%}
    {{ reprise_entry_script_tags('user') }}
{%- endblock %}
