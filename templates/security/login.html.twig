{% extends 'layouts/full.html.twig' %}

{% block title 'Connexion' %}

{% block breadcrumb -%}
    {% do menu.addItem('Connexion', url('app_login')) %}
{%- endblock %}

{% block meta_description 'Connectez-vous à votre compte By Night pour retrouver vos événements favoris, gérer vos sorties et partager vos découvertes.' %}

{% block body %}
    <div class="container-lg py-4 py-lg-5">
        <div class="row justify-content-center">
            <div class="col-xl-11">
                <div class="card card-lg overflow-hidden mb-0">
                    <div class="row g-0">
                        {# The photo only frames the form: phones and tablets go straight to it #}
                        <div class="col-lg-5 d-none d-lg-block position-relative text-white bg-dark">
                            <div class="card-img-overlay p-0 img-cover">
                                <twig:Picasso:Image src="{{ asset('build/images/landing.jpg', 'local') }}" width="{{ 480 }}" height="{{ 720 }}" fit="crop" sizes="(min-width: 1200px) 450px, 40vw" alt="" />
                            </div>
                            <div class="card-img-overlay card-img-overlay-dark d-flex flex-column justify-content-between p-4 p-xl-5">
                                <div>
                                    <span class="badge bg-white text-body">
                                        <twig:Icon name="lucide:user" />
                                        Espace membre
                                    </span>
                                </div>
                                <div>
                                    <p class="h2 mb-3">«&nbsp;Toutes les sorties de votre ville, du concert du soir à l'expo du week-end.&nbsp;»</p>
                                    <p class="mb-4 opacity-75">Retrouvez les événements que vous suivez et publiez les vôtres&nbsp;: ils rejoignent l'agenda en quelques clics.</p>
                                    <p class="small fw-bold mb-0 opacity-75">
                                        <twig:Icon name="lucide:shield-check" />
                                        Connexion chiffrée
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="card-body p-4 p-md-5">
                                <twig:Section:Eyebrow icon="lucide:lock" badge="{{ true }}">Connexion sécurisée</twig:Section:Eyebrow>
                                <h1 class="text-start mb-2">Connexion à votre compte</h1>
                                <p class="text-secondary mb-4">
                                    Accédez à votre espace pour publier et gérer vos événements, et retrouvez les sorties qui vous intéressent.
                                </p>

                                <form method="post" action="{{ path('app_login') }}">
                                    {% if error %}
                                        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                                    {% endif %}

                                    <twig:Auth:SocialButtons title="Connectez-vous avec" />

                                    <div class="hr-text">ou avec votre adresse e-mail</div>

                                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}" />

                                    <div class="form-group">
                                        {# UserRepository::loadUserByIdentifier() also accepts the username the older accounts signed in with #}
                                        <label class="form-label" for="username">Adresse e-mail ou nom d'utilisateur</label>
                                        <twig:InputIcon iconPrepend="lucide:mail">
                                            <input class="form-control" type="text" id="username" name="username" value="{{ last_username }}" autocomplete="username" placeholder="vous@exemple.fr" required />
                                        </twig:InputIcon>
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label" for="password">
                                            Mot de passe
                                            <span class="form-label-description">
                                                <a href="{{ path('app_forgot_password_request') }}" title="Récupérez votre mot de passe oublié">Mot de passe oublié&nbsp;?</a>
                                            </span>
                                        </label>
                                        <twig:PasswordInput>
                                            <input class="form-control" type="password" id="password" name="password" autocomplete="current-password" required />
                                        </twig:PasswordInput>
                                    </div>

                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="remember_me" name="_remember_me" value="on" checked />
                                        <label class="form-check-label" for="remember_me">Se souvenir de moi</label>
                                    </div>
                                    <button class="btn btn-primary btn-lg w-100 mt-4" type="submit">
                                        Se connecter
                                        <twig:Icon name="lucide:arrow-right" class="icon-end" />
                                    </button>
                                </form>

                                <p class="text-center text-secondary mt-4">
                                    Pas encore de compte&nbsp;?
                                    <a class="fw-bold" href="{{ path('app_register') }}" title="Créez votre compte gratuitement">Créer un compte gratuitement</a>
                                </p>

                                <div class="card bg-teal-lt border-0 mb-0">
                                    <div class="card-body d-flex align-items-start gap-3">
                                        <span class="avatar avatar-sm bg-white text-teal flex-shrink-0">
                                            <twig:Icon name="lucide:badge-check" />
                                        </span>
                                        <div>
                                            <h2 class="card-title text-start mb-1">Vous organisez des événements&nbsp;?</h2>
                                            <p class="small mb-0">
                                                La publication et le référencement de vos événements restent <strong>100&nbsp;% gratuits</strong> sur By Night.
                                                <a href="{{ path('app_plus') }}" title="Comment publier un événement">Comment ça marche</a>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
