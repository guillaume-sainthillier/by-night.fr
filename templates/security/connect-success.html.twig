{% extends 'layouts/full.html.twig' %}

{% block title 'Connexion réussie' %}

{% set userInfo = {
    username: userInformation.name,
    email: userInformation.email,
} %}

{% block body -%}
    <div class="container-lg py-5 text-center">
        <div class="alert alert-success d-inline-flex align-items-center gap-2">
            <twig:Icon name="lucide:check" />
            Bienvenue {{ userInformation.name }}
        </div>
        <p class="text-secondary d-flex align-items-center justify-content-center gap-2 mb-0">
            <span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
            {# The way on, should the redirection below not run #}
            <span>Veuillez patienter, vous allez être redirigé… <a href="{{ targetPath }}">Continuer</a></span>
        </p>
    </div>
{%- endblock %}

{# Opened in a popup (a network connected from "Mon compte"), the page tells its opener and closes; otherwise it goes on
   to the page the member logged in from #}
{% block head_js %}
    <script type="text/javascript">
        if (typeof window.opener !== "undefined" && window.opener !== null && typeof window.opener.parent_elem !== "undefined") {
            window.opener
                .$('body')
                .trigger("hasConnected", {
                    'user': {{ userInfo|json_encode|raw }},
                    'target': window.opener.parent_elem
                });
            window.close();
        } else {
            document.location = {{ targetPath|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP'))|raw }};
        }
    </script>
{% endblock %}
