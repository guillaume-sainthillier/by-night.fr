{% extends 'bundles/TwigBundle/Exception/_client-error.html.twig' %}

{% block title 'Page introuvable' %}

{% block body %}
    {% set location = app_context.location %}
    <twig:ErrorPage code="404" label="Page introuvable" icon="lucide:compass">
        <twig:ErrorPage:Title>Cette page n'existe pas (ou plus)</twig:ErrorPage:Title>
        <twig:ErrorPage:Description>
            L'adresse est peut-être mal saisie, ou l'événement a été retiré par son organisateur.
            Cherchez une sortie, ou repartez de l'agenda{% if location %} {{ location.atName }}{% endif %}.
        </twig:ErrorPage:Description>
        <twig:ErrorPage:Search city="{{ location.city.slug ?? null }}" />
        <twig:ErrorPage:Actions>
            {% if location %}
                <a class="btn btn-primary" href="{{ path('app_location_index', {location: location.slug}) }}">
                    <twig:Icon name="lucide:calendar-days" />
                    Sortir {{ location.atName }}
                </a>
            {% endif %}
            <a class="btn {{ location ? 'btn-outline-secondary' : 'btn-primary' }}" href="{{ path('app_index') }}">
                <twig:Icon name="lucide:home" />
                Retour à l'accueil
            </a>
        </twig:ErrorPage:Actions>
    </twig:ErrorPage>

    {{ include('bundles/TwigBundle/Exception/_lost-links.html.twig') }}
{% endblock %}
