<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta charset="{{ _charset }}"/>
    <title>{{ title }}</title>

    <!-- Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=yyQOxPP629">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=yyQOxPP629">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=yyQOxPP629">
    <link rel="manifest" href="/site.webmanifest?v=yyQOxPP629">
    <link rel="mask-icon" href="/safari-pinned-tab.svg?v=yyQOxPP629" color="#d94826">
    <link rel="shortcut icon" href="/favicon.ico?v=yyQOxPP629">
    <meta name="msapplication-TileColor" content="#d94826">
    <meta name="theme-color" content="#d94826">
    <!-- ./Icons -->

    <!-- CSS -->
    {{ reprise_entry_link_tags('app') }}
    <!-- ./CSS-->
</head>
<body class="error-page">
<div class="container-fluid d-flex flex-column h-100">
    <div class="d-flex flex-column box-error">
        <div class="row g-0">
            <div class="col-auto">
                <h1>{{ code }}</h1>
            </div>
            <div class="col">
                <h2>{{ message }}</h2>
                <p>{{ description }}</p>
            </div>
        </div>

        <form method="get" action="{{ path('app_search_index') }}">
            <div class="input-group">
                    <span class="input-group-text">
                        <twig:Icon name="lucide:search" />
                    </span>
                <input name="q" class="form-control" size="16" type="text" placeholder="Que cherchez-vous ?"/>
                <input class="btn btn-outline-secondary" type="submit" value="Rechercher"/>
            </div>
        </form>

        {# The page has neither the header nor the footer: the way back to the site #}
        <div class="text-center mt-4">
            <a class="btn btn-primary" href="{{ path('app_index') }}">
                <twig:Icon name="lucide:home" />
                Retour à l'accueil
            </a>
        </div>
    </div>
</div>
{{ reprise_entry_script_tags('app') }}
</body>
</html>
