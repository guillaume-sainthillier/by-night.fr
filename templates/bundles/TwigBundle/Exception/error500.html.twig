{% extends 'bundles/TwigBundle/Exception/_server-error.html.twig' %}

{% block title 'Erreur du serveur' %}

{% block body %}
    <twig:ErrorPage code="500" illustration="server-error" label="Erreur du serveur" icon="lucide:wrench">
        <twig:ErrorPage:Title>Un imprévu de notre côté</twig:ErrorPage:Title>
        <twig:ErrorPage:Description>
            Cette page n'a pas pu s'afficher. L'erreur nous a été signalée et nous la corrigeons au plus vite&nbsp;:
            réessayez dans un instant, ou cherchez votre sortie autrement.
        </twig:ErrorPage:Description>
        <twig:ErrorPage:Search />
        <twig:ErrorPage:Actions>
            <a class="btn btn-primary" href="{{ app.request.requestUri }}">
                <twig:Icon name="lucide:rotate-cw" />
                Réessayer
            </a>
            <a class="btn btn-outline-secondary" href="{{ path('app_index') }}">
                <twig:Icon name="lucide:home" />
                Retour à l'accueil
            </a>
        </twig:ErrorPage:Actions>
    </twig:ErrorPage>
{% endblock %}
