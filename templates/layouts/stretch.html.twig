{% extends 'base.html.twig' %}

{% block layout_top %}
    {{ include('layouts/_flash-messages.html.twig', {container_class: block('container_class')}) }}
    {% block layout_header '' %}
    <div class="page-header">
        <div class="d-flex flex-wrap align-items-center justify-content-center gap-2">
            <h1>{% block page_title block('title') %}</h1>
            {% block title_after '' %}
        </div>
    </div>
{% endblock %}

{% block layout_body %}
    <div class="{% block container_class 'container' %}" id="container">
        {% block body '' %}
    </div>
{% endblock %}
