{%- block modal -%}
    <form action="{% block form_action '#' %}" method="POST">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 class="modal-title">{% block page_title '' %}</h3>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    {% block body '' %}
                </div>
                <div class="modal-footer">
                    <twig:Tabler:Button variant="secondary" appearance="outline" type="button" data-bs-dismiss="modal" class="btn_back">Fermer</twig:Tabler:Button>
                    {% block footer '' %}
                </div>
            </div>
        </div>
    </form>
{%- endblock -%}
