<!DOCTYPE HTML>
<!--
_______     __  _   _ _____ _____ _    _ _______
|  _ \ \   / / | \ | |_   _/ ____| |  | |__   __|
| |_) \ \_/ /  |  \| | | || |  __| |__| |  | |
|  _ < \   /   | . ` | | || | |_ |  __  |  | |
| |_) | | |    | |\  |_| || |__| | |  | |  | |
|____/  |_|    |_| \_|_____\_____|_|  |_|  |_|

-->
<html prefix="og: http://ogp.me/ns#" lang="{{ app.request.locale }}" xmlns:fb="http://ogp.me/ns/fb#" data-bs-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta http-equiv="Content-Language" content="fr">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% apply spaceless %}{%- block title -%}{%- endblock -%}{% endapply %} - By Night</title>
    <meta name="title" content="{{- block('title') -}}">
    <meta name="keywords" content="{% block meta_full_keywords %}{% block meta_keywords '' %}aujourd'hui,ce,soir,soiree,sortie,concert,spectacle,musique,discotheque,boite,de,nuit{% endblock %}">
    <meta name="description" content="{% block meta_description 'Découvrez des milliers de concerts, spectacles, expos et sorties partout en France avec By Night.' %}">

    <!-- Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=yyQOxPP629">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=yyQOxPP629">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=yyQOxPP629">
    <link rel="manifest" href="/site.webmanifest?v=yyQOxPP629">
    <link rel="mask-icon" href="/safari-pinned-tab.svg?v=yyQOxPP629" color="#3f51b5">
    <link rel="shortcut icon" href="/favicon.ico?v=yyQOxPP629">
    <meta name="msapplication-TileColor" content="#3f51b5">
    <meta name="theme-color" content="#3f51b5">
    <!-- ./Icons -->

    <!-- OpenGraph -->
    <meta property="og:site_name" content="By Night">
    <meta property="og:description" content="{% block og_description block('meta_description') %}">
    <meta property="og:title" content="{% block og_title block('title') %}">
    <meta property="og:type" content="{% block og_type 'website' %}">
    <meta property="og:url" content="{% block og_url url('app_index') %}">
    <meta property="og:locale" content="fr" />
    <meta property="og:image" content="{% block og_image absolute_url(asset('build/images/by-night.png')) %}">
    <meta property="og:image:width" content="{% block og_image_width '1200' %}">
    <meta property="og:image:height" content="{% block og_image_height '630' %}">
    <meta property="og:image:alt" content="{{ block('og_title') }}">
    <!-- ./OpenGraph -->

    <!-- Twitter -->
    {% if social_manager.twitterIdPage %}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@{{ social_manager.twitterIdPage }}" />
        <meta name="twitter:title" content="{{ block('og_title') }}" />
        <meta name="twitter:description" content="{{ block('og_description') }}" />
        <meta name="twitter:image" content="{{ block('og_image') }}" />
    {% endif %}
    {% block twitter '' %}
    <!-- ./Twitter -->

    <!-- FB -->
    {% if social_manager.facebookIdPage %}
        <meta property="fb:page_id" content="{{ social_manager.facebookIdPage }}" />
    {% endif %}
    {% block facebook '' %}
    <!-- ./FB -->

    <!-- Google -->
    {% block google '' %}
    <!-- ./Google -->

    <!-- DC -->
    <meta name="dc.description" content="{{ block('og_description') }}">
    <meta name="dc.title" content="{{ block('og_title') }}">
    <meta name="dc.keywords" content="{{ block('meta_full_keywords') }}" />
    <!-- ./DC -->

    {% block metas '' %}
    {# Pages not worth indexing (empty listings, long-ended events, empty profiles) set a "noindex" here #}
    {% block meta_robots '' %}

    <link rel="canonical" href="{{ url(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}" />

    <!-- CSS -->
    {{ reprise_entry_link_tags('app') }}
    {% block css '' %}
    <!-- ./CSS -->

    {# Google's consent platform, AdSense and Tag Manager only run in production: dev and test pages would count as
       AdSense traffic #}
    {% if app.environment == 'prod' %}
        {{ include('fragments/_google-tags.html.twig') }}
    {% endif %}

    {{ site_json_ld() }}
    {% block json_ld '' %}
    {% block head_js_layout '' %}
    {% block head_js '' %}
</head>
<body class="{% block body_class '' %}" id="{% block body_id 'page' %}">
{% set container_class %}{% block container_class 'container-lg' %}{% endset %}
<div class="page">
    <!-- Menu -->
    {{ include('fragments/header.html.twig') }}
    <!-- ./Menu -->

    {{ include('fragments/_impersonation-banner.html.twig') }}

    {% block breadcrumb_widget %}
        <div id="bread">
            <div class="{{ container_class }}">
                {% do menu.addItem('By Night', url('app_index')) %}

                {% block breadcrumb '' %}
                {{ wo_render_breadcrumbs({separator: null, listClass: 'breadcrumb', itemClass: 'breadcrumb-item'}) }}
                {{ breadcrumb_json_ld(menu) }}
            </div>
        </div>
    {% endblock %}

    <!-- Main -->
    <div class="page-wrapper">
        {% block layout_top '' %}
        {% block page_body %}
            <div class="page-body">
                {% block layout_body %}{% block body '' %}{% endblock %}
            </div>
        {% endblock %}
        <!-- Footer -->
        {{ include('fragments/footer.html.twig') }}
        <!-- ./Footer -->
    </div>
    <!-- ./Main -->
</div>

<!-- Modals -->
<div class="modal fade" id="dialog_details" tabindex="-1" role="dialog" aria-hidden="true">
    {{ include('layouts/modal.html.twig') }}
</div>
{% block modals '' %}
<!-- ./Modals -->

<button type="button" id="toTop" class="btn btn-icon btn-primary">
    <twig:Icon name="lucide:chevron-up" />
</button>

<!-- JS -->
{{ reprise_entry_script_tags('app') }}
{# A module script so it runs after the app entry module (deferred, document order), once window.$ and window.App exist. #}
<script type="module">
    $(document).ready(function () {
    App.start({{ {
        environment: app.environment,
        locale: app.request.locale,
        release: app_version,
        dsn: sentry_dsn,
        user: (app.user ? {id: app.user.id, username: app.user.username, email: app.user.email} : null),
    }|json_encode|raw }});
  });
</script>
{%- block js -%}{%- endblock -%}
<!-- ./JS -->
</body>
</html>
