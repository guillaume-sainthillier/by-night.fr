{% use 'form_div_layout.html.twig' with checkbox_widget as base_checkbox_widget %}
{% use 'bootstrap_5_layout.html.twig' %}
{% use 'bootstrap_5_layout.html.twig' with form_label as inline_form_label %}

{# Stateless CSRF protection - add Stimulus controller to CSRF token field #}
{%- block csrf_token_widget -%}
    <input type="hidden" {{ block('widget_attributes') }} data-controller="csrf-protection" value="{{ value }}" />
{%- endblock csrf_token_widget -%}

{% block vich_image_widget %}
    {% set has_existing_image = download_uri is defined and download_uri %}
    {% set is_horizontal = layout is defined and layout == 'horizontal' %}

    <div class="vich-image-wrapper {{ is_horizontal and has_existing_image ? 'vich-image-horizontal' }}">
        {% if has_existing_image and image_thumb is not null %}
            <div class="vich-image-existing">
                <a class="image-gallery" href="{{ download_uri }}">
                    <twig:Picasso:Image
                        loader="{{ image_thumb.loader }}"
                        src="{{ image_thumb.src }}"
                        context="{{ image_thumb.context }}"
                        unoptimized="{{ image_thumb.unoptimized|default(false) }}"
                        width="{{ image_thumb.width|default(null) }}"
                        height="{{ image_thumb.height|default(null) }}"
                    />
                </a>
                {% if has_uploaded_image is defined and has_uploaded_image and form.delete is defined %}
                    <div class="delete-image mt-2">
                        {{ form_row(form.delete) }}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        <div class="dropzone">
            <div class="dropzone-preview d-none"></div>

            <div class="dropzone-placeholder">
                <div class="dropzone-icon">
                    <twig:Icon name="{{ has_existing_image ? 'lucide:replace' : 'lucide:image-up' }}" />
                </div>
                <div class="dropzone-text">
                    {% if has_existing_image %}
                        Glissez une nouvelle image pour remplacer l'actuelle
                    {% else %}
                        Glissez-déposez une image ou cliquez pour parcourir
                    {% endif %}
                </div>
                <div class="dropzone-hint text-muted">PNG, JPG ou GIF</div>
            </div>

            {{ form_widget(form.file) }}
        </div>
    </div>
{% endblock %}

{# Images #}
{% block file_widget %}
    <div class="custom-file mt-2">
        {{ block('form_widget') }}
    </div>
{% endblock %}

{%- block date_range_row -%}
    {{ form_widget(form.from) }}
    {% if form.to is defined %}
        {{ form_widget(form.to) }}
    {% endif %}
    {% set range_options = {
        icon_prepend: icon_prepend|default(null),
        icon_append: icon_append|default(null),
    }|merge(label is defined ? {label: label} : {})|merge(row_class is defined ? {row_class: row_class} : {}) %}
    {{ form_row(form.range, range_options) }}
    {{ form_errors(form.from) }}
    {% if form.to is defined %}
        {{ form_errors(form.to) }}
    {% endif %}
{%- endblock -%}

{% block app_collection_entry_form_row %}
    {{ form_row(child, attr|merge({label: false, row_class: row_class|default('form-group')})) }}
{% endblock %}

{# Special block in order to let child redefine whole block #}
{% block app_collection_entry_widget_row %}
    {% if layout == 'simple' %}
        {{- block('app_collection_entry_widget_row_simple') -}}
    {% else %}
        {{- block('app_collection_entry_widget_row_complex') -}}
    {% endif %}
{% endblock %}

{% block app_collection_entry_widget_row_simple %}
    <div{% with {attr: collection_item_attr|merge({class: (collection_item_attr.class|default('') ~ ' collection-item row g-2 align-items-start')|trim})} %}{{ block('attributes') }}{% endwith %}>
        <div class="col">
            {% with child.vars|merge({row_class: ''}) %}
                {{- block('app_collection_entry_form_row') -}}
            {% endwith %}
        </div>
        {% if not disabled and allow_delete %}
            <div class="col-auto">
                <button class="btn btn-icon btn-ghost-danger remove-collection" data-item=".collection-item" type="button" data-confirm-message="{{ delete_entry_confirm_label|default('Supprimer la ligne ?') }}" data-bs-toggle="tooltip" title="Supprimer">
                    <twig:Icon name="lucide:trash-2" />
                </button>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block app_collection_entry_widget_row_complex %}
    <div{% with {attr: collection_item_attr|merge({class: (collection_item_attr.class|default('') ~ ' collection-item accordion-item')|trim})} %}{{ block('attributes') }}{% endwith %}>
        <div class="accordion-header d-flex align-items-center">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-{{ child.vars.id }}" aria-expanded="true" aria-controls="collapse-{{ child.vars.id }}">
                {% with child.vars %}{{ label }}{% endwith %}
            </button>
            {% if not disabled and allow_delete %}
                <button class="btn btn-sm btn-icon btn-outline-danger remove-collection me-2" data-item=".collection-item" type="button" data-confirm-message="{{ delete_entry_confirm_label|default('Supprimer la ligne ?') }}" data-bs-toggle="tooltip" title="Supprimer">
                    <twig:Icon name="lucide:x" />
                </button>
            {% endif %}
        </div>
        <div id="collapse-{{ child.vars.id }}" class="accordion-collapse collapse show">
            {{ form_widget(child, {attr: {class: 'accordion-body'}}) }}
        </div>
    </div>
{% endblock %}

{%- block app_collection_row -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' collection')|trim}) -%}
    {{ form_row(form, {attr: attr}) }}
{%- endblock -%}

{% block app_collection_widget %}
    <div class="collection-wrapper">
        {% set attr = attr|merge({class: (attr.class|default('') ~ (layout == 'complex' ? ' accordion' : ''))|trim}) %}
        {% if prototype is defined and not prototype.rendered %}
            {% set child = prototype %}
            {% set attr = attr|merge({
                'data-prototype': block('app_collection_entry_widget_row'),
                'data-prototype-name': prototype.vars.name,
            }) %}
        {% endif %}
        <div {{ block('widget_container_attributes') }}>
            {%- if form is rootform -%}
                {{ form_errors(form) }}
            {%- endif -%}
            {% for child in form|filter(child => not child.rendered) %}
                {% with child.vars %}
                    {{- block('app_collection_entry_widget_row') -}}
                {% endwith %}
            {% endfor %}
            {{- form_rest(form) -}}
        </div>
        {% if not disabled and allow_add %}
            <button type="button" class="add-collection btn btn-with-icon mt-2">
                <span><twig:Icon name="lucide:plus" /></span>
                {{ add_entry_label|default('Ajouter une ligne') }}
            </button>
        {% endif %}
    </div>
{% endblock %}

{%- block form_row -%}
    {%- if compound is defined and compound -%}
        {%- set element = 'fieldset' -%}
    {%- endif -%}
    {%- set widget_attr = {} -%}
    {%- if help is not empty -%}
        {#- Merged: passing a bare "attr" would drop the field's own (autocomplete, placeholder…) -#}
        {%- set widget_attr = {attr: attr|merge({'aria-describedby': id ~ '_help'})} -%}
    {%- endif -%}
    {%- set row_class = row_class|default(row_attr.class|default('form-group')|trim) -%}
    <{{ element|default('div') }}{% with {attr: row_attr|merge({class: row_class})} %}{{ block('attributes') }}{% endwith %}>
    {%- if 'form-floating' in row_class -%}
        {{- form_widget(form, widget_attr) -}}
        {{- form_label(form) -}}
    {%- else -%}
        {{- form_label(form) -}}
        {% if icon_prepend or icon_append %}
            <twig:InputIcon iconPrepend="{{ icon_prepend }}" iconAppend="{{ icon_append }}">
                {{- form_widget(form, widget_attr) -}}
            </twig:InputIcon>
        {% else %}
            {{- form_widget(form, widget_attr) -}}
        {% endif %}
    {%- endif -%}
    {{- form_help(form) -}}
    {{- form_errors(form) -}}
    </{{ element|default('div') }}>
{%- endblock form_row %}

{# NewPasswordType: the password with its show/hide button and the strength meter (listeners/password-meter.js,
   which checks the same password_rules as the server), then the confirmation #}
{%- block new_password_row -%}
    {%- set first = form.first -%}
    {%- set rules_id = first.vars.id ~ '_rules' -%}
    <div class="form-group">
        {{- form_label(first) -}}
        <twig:PasswordInput>
            {{- form_widget(first, {attr: first.vars.attr|merge({'aria-describedby': rules_id})}) -}}
        </twig:PasswordInput>
        {{- form_errors(first) -}}
        <div class="mt-2" data-password-meter="{{ first.vars.id }}">
            <div class="progress progress-sm mb-2" role="progressbar" aria-label="Sécurité du mot de passe" aria-valuemin="0" aria-valuemax="{{ password_rules|length }}" aria-valuenow="0">
                <div class="progress-bar" style="width: 0"></div>
            </div>
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 small">
                <span class="subheader">Sécurité du mot de passe</span>
                <ul class="list-inline mb-0 text-secondary" id="{{ rules_id }}">
                    {%- for rule in password_rules %}
                        <li class="list-inline-item me-2" data-password-meter-rule="{{ rule.pattern }}">
                            <span class="text-secondary" data-password-meter-rule-icon="unmet"><twig:Icon name="lucide:circle" class="icon-inline" /></span>
                            <span class="text-success d-none" data-password-meter-rule-icon="met"><twig:Icon name="lucide:circle-check" class="icon-inline" /></span>
                            {{ rule.label }}
                        </li>
                    {%- endfor %}
                </ul>
            </div>
        </div>
    </div>
    <div class="form-group">
        {{- form_label(form.second) -}}
        <twig:PasswordInput icon="lucide:lock-keyhole" toggle="{{ false }}">
            {{- form_widget(form.second) -}}
        </twig:PasswordInput>
        {{- form_errors(form.second) -}}
    </div>
    {{- form_errors(form) -}}
{%- endblock new_password_row %}

{# CityPickerType: the name typed in the autocomplete of the cities (pages/profile.js reads data-city-picker), and the
   slug of the city chosen in the list. The label and the error state go to the name, the only field the member sees #}
{%- block city_picker_row -%}
    {%- set name = form.name -%}
    {%- set name_attr = name.vars.attr -%}
    {%- if help is not empty -%}
        {%- set name_attr = name_attr|merge({'aria-describedby': id ~ '_help'}) -%}
    {%- endif -%}
    {%- if not valid -%}
        {%- set name_attr = name_attr|merge({class: (name_attr.class|default('') ~ ' is-invalid')|trim}) -%}
    {%- endif -%}
    <div class="form-group" data-city-picker="{{ path('api_cities', {q: '__QUERY__'}) }}">
        {{- form_label(name, label) -}}
        <twig:InputIcon iconPrepend="lucide:map-pin">
            {{- form_widget(name, {attr: name_attr}) -}}
        </twig:InputIcon>
        {{- form_widget(form.slug) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock city_picker_row %}
