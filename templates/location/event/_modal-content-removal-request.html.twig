<twig:Tabler:Modal id="modalContentRemovalRequest" centered class="fade" role="dialog">
    <twig:Tabler:Modal:Header>
        <twig:Tabler:Modal:Title>Signaler un contenu</twig:Tabler:Modal:Title>
        <twig:Tabler:Modal:Close aria-label="Fermer" />
    </twig:Tabler:Modal:Header>
    <twig:Tabler:Modal:Body>
        {# Its variant is set by listeners/content-removal-request.ts #}
        <twig:Tabler:Alert variant="" id="content-removal-alert" class="d-none" />
        <form id="content-removal-form">
            <div class="mb-3">
                <label for="removal-email" class="form-label">Votre adresse e-mail <span class="text-danger">*</span></label>
                <input type="email" class="form-control" id="removal-email" required placeholder="votre@email.com">
                <div class="invalid-feedback">Veuillez saisir une adresse e-mail valide.</div>
            </div>
            <div class="mb-3">
                <label for="removal-type" class="form-label">Type de contenu à supprimer <span class="text-danger">*</span></label>
                <select class="form-select" id="removal-type" required>
                    <option value="">-- Sélectionnez --</option>
                    <option value="image">Image de couverture</option>
                    <option value="event">Événement complet</option>
                </select>
                <div class="invalid-feedback">Veuillez sélectionner le type de contenu</div>
            </div>
            <div class="mb-3">
                <label for="removal-message" class="form-label">Motif de la demande <span class="text-danger">*</span></label>
                {% set min_length = constant('App\\Api\\Model\\ContentRemovalRequestInput::MESSAGE_MIN_LENGTH') %}
                <textarea class="form-control" id="removal-message" rows="4" required placeholder="Expliquez la raison de votre demande (min. {{ min_length }} caractères)"></textarea>
                <div class="invalid-feedback">Votre message doit faire au moins {{ min_length }} caractères</div>
            </div>
            <div class="mb-3">
                <label for="removal-urls" class="form-label">URLs de l'événement (optionnel)</label>
                <textarea class="form-control" id="removal-urls" rows="2" placeholder="Une URL par ligne (optionnel)"></textarea>
                <div class="form-text">Si cet événement apparaît sur d'autres sites, indiquez les URLs ici.</div>
            </div>
        </form>
    </twig:Tabler:Modal:Body>
    <twig:Tabler:Modal:Footer>
        <twig:Tabler:Button variant="secondary" appearance="outline" type="button" data-bs-dismiss="modal">Annuler</twig:Tabler:Button>
        <twig:Tabler:Button variant="primary" type="button" id="content-removal-submit">
            <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
            Envoyer
        </twig:Tabler:Button>
    </twig:Tabler:Modal:Footer>
</twig:Tabler:Modal>
