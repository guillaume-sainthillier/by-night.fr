{% extends 'layouts/full.html.twig' %}
{# isHiddenDraft (from the controller): a draft the viewer cannot edit. It only gets a notice, and nothing of the event
   may reach the head either (title, description, poster, JSON-LD) or the breadcrumb: that is what scrapers read #}
{% set eventShortName = event_seo.getEventShortTitle(event) %}
{% set schedules = event_seo.getEventDateTime(event) %}
{% set eventDescription = event.description|parse_tags|raw %}
{% set original = eventProfilePicture.originalPicture(event) %}

{% set place = event.place %}
{# The way back after a login: "#participer" records the "J'y vais" clicked before it (like.js), "#comments" opens on the
   comment form #}
{% set eventRoute = {slug: event.slug, id: event.id, location: event.locationSlug} %}
{% set goingAfterLogin = path('app_event_details', eventRoute|merge({_fragment: 'participer'})) %}
{# Collect all tags (category + themes) for meta tags #}
{% set allTags = [] %}
{% if event.category %}
    {% set allTags = allTags|merge([event.category]) %}
{% endif %}
{% for tag in event.themes %}
    {% set allTags = allTags|merge([tag]) %}
{% endfor %}

{% block body_id 'page-event' %}
{% block title isHiddenDraft ? 'Événement bientôt disponible' : event_seo.eventFullTitle(event) %}

{% block breadcrumb %}
    {% if location.isCountry %}
        {% do menu.addItem(location.country.displayName, url('app_location_index', {location: location.country.slug})) %}
    {% else %}
        {% do menu.addItem(location.city.country.displayName, url('app_location_index', {location: location.city.country.slug})) %}
        {% do menu.addItem('Sortir ' ~ event.placeCity|at_place, url('app_location_index', {location: location.city.slug})) %}
    {% endif %}

    {% if not isHiddenDraft %}
        {% do menu.addItem(event.placeName, url('app_agenda_by_place', {location: location.slug, placeSlug: place.slug})) %}
        {% do menu.addItem(event.name, url('app_event_details', {slug: event.slug, id: event.id, location: event.locationSlug})) %}
    {% endif %}
{% endblock %}

{% block meta_keywords %}{% if not isHiddenDraft and allTags|length > 0 %}{{ allTags|map(t => t.name)|join(',') }},{% endif %}{{ parent() }}{% endblock %}
{% block meta_description isHiddenDraft ? parent() : event_seo.eventDescription(event) %}

{% block metas %}
    {% if not isHiddenDraft %}
        <link rel="image_src" href="{{ original }}" />
        <meta property="article:published_time" content="{{ event.createdAt.format('Y-m-d') }}" />
        <meta property="article:publisher" content="https://www.facebook.com/pages/By-Night/{{ social_manager.facebookIdPage }}" />
        {% if event.user %}
            <meta property="article:author" content="{{ url('app_user_index', {id: event.user.id, slug: event.user.slug}) }}" />
        {% endif %}

        {% for tag in allTags %}
            <meta property="article:tag" content="{{ tag.name }}" />
        {% endfor %}
    {% endif %}
{% endblock %}

{% block meta_robots %}
    {% if not event_seo.isIndexable(event) %}
        <meta name="robots" content="noindex, follow">
    {% endif %}
{% endblock %}

{% block og_title isHiddenDraft ? parent() : eventShortName %}
{# Kept for a hidden draft: the visitor already has this URL, and pointing og:url elsewhere would make the platforms that
   scraped it now send the shares made once the event is published to that other page #}
{% block og_url url('app_event_details', {slug: event.slug, id: event.id, location: event.locationSlug}) %}
{% block og_image isHiddenDraft ? parent() : original %}

{# The poster morphs from the card the visitor clicked (scss/components/_view-transitions.scss): the first render, which
   the view transition captures, waits for it to be parsed #}
{% block head_js %}
    {% if not isHiddenDraft %}
        <link rel="expect" href="#event-poster" blocking="render">
    {% endif %}
{% endblock %}

{% block json_ld %}
    {% if not isHiddenDraft %}
        {{ event_json_ld(event, ticketOffers ?? null) }}
    {% endif %}
{% endblock %}

{% block body -%}
    <div {{ load_page('event_details') }}></div>
    {% if isHiddenDraft %}
        <div class="container-lg py-4">
            <header class="event-header mb-4">
                <h1 class="display-6 fw-bold text-start">{{ block('title') }}</h1>
            </header>
            <div class="alert alert-warning">
                <twig:Icon name="lucide:triangle-alert" />
                Cet événement n'est pas encore publié. Il sera bientôt disponible, merci de votre patience.
                {% if not is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                    {# Its author, logged out, gets back to their preview; the visitor already has this URL #}
                    Vous en êtes l'organisateur&nbsp;?
                    <a rel="nofollow" href="{{ path('app_login', {_target_path: app.request.pathInfo}) }}">Connectez-vous pour le voir</a>.
                {% endif %}
            </div>
        </div>
    {% else %}
        {% set price = event.prices|price_label(event.startingPrice) %}
        {% set hasEnded = event_seo.hasEnded(event) %}
        {% set placeAgenda = path('app_agenda_by_place', {placeSlug: place.slug, location: place.locationSlug}) %}
        {% set agenda = path('app_location_index', {location: place.locationSlug}) %}

        {# The embedded map looks the venue up by name, or by its coordinates when it has no city to name #}
        {% set mapValue = (event.placeName ~ ' ' ~ event.placeCity)|trim %}
        {% if event.latitude and event.longitude and not place.city %}
            {% set mapValue = event.latitude ~ ',' ~ event.longitude %}
        {% endif %}
        {% set directionsTo = event.latitude and event.longitude
            ? event.latitude ~ ',' ~ event.longitude
            : [event.placeName, event.placeStreet, event.placePostalCode, event.placeCity]|filter(part => part)|join(' ') %}
        {% set calendarUrl = hasEnded ? null : google_calendar_url(event, eventUrl) %}
        {# Where to book, cheapest first (EventTicketOffers). Once the event is over, only the ticketing sites' links stay #}
        {% set offers = (ticketOffers ?? [])|filter(offer => offer.affiliate or not hasEnded) %}
        {% set bestOffer = offers|first %}

        {% set going = (event.participations ?? 0) + (event.fbParticipations ?? 0) %}
        {% set interested = (event.interests ?? 0) + (event.fbInterests ?? 0) %}

        <div class="container-lg py-4" id="event">
            <header class="event-header mb-4">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    {% if event.category %}
                        <a class="badge bg-primary-lt" href="{{ path('app_agenda_by_tag', {tagSlug: event.category.slug, tagId: event.category.id, location: place.locationSlug}) }}" title="{{ event.category.name }} {{ place.location.atName }}">
                            {{ event.category.name }}
                        </a>
                    {% endif %}
                    {% if price and price.free %}
                        <span class="badge bg-teal-lt">
                            <twig:Icon name="lucide:badge-check" />
                            Entrée gratuite
                        </span>
                    {% endif %}
                    <a class="badge bg-secondary-lt" href="{{ agenda }}" title="Sortir {{ place.location.atName }}">
                        <twig:Icon name="lucide:map-pin" />
                        Sortir {{ place.location.atName }}
                    </a>
                </div>
                <div class="d-flex align-items-start gap-3">
                    <h1 class="display-6 fw-bold text-start">{{ block('title') }}</h1>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a class="btn btn-icon btn-outline-secondary flex-shrink-0" href="{{ path('admin_event_edit', {entityId: event.id}) }}" data-bs-toggle="tooltip" title="Modifier l'événement">
                            <twig:Icon name="lucide:pencil" />
                        </a>
                    {% elseif is_granted(constant('\\App\\Security\\Voter\\EventVoter::EDIT'), event) %}
                        {# The author corrects their event from their personal space #}
                        <a class="btn btn-outline-secondary flex-shrink-0" href="{{ path('app_event_edit', {id: event.id}) }}" title="Modifier l'événement">
                            <twig:Icon name="lucide:pencil" />
                            <span class="d-none d-sm-inline">Modifier</span>
                        </a>
                    {% endif %}
                </div>
            </header>

            {# An event its source no longer lists is hidden as a draft, but has nothing to publish: its status says why #}
            {% if event.draft and not event.removedAtSource %}
                <div class="alert alert-info" id="event-draft-notice" role="status">
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <twig:Icon name="lucide:eye" class="alert-icon" />
                        <div class="flex-fill">
                            <div class="fw-bold">Aperçu&nbsp;: cet événement n'est pas encore publié</div>
                            Seuls son auteur et les administrateurs le voient. Publiez-le pour qu'il apparaisse dans l'agenda.
                        </div>
                        <button type="button" class="btn btn-primary" data-publish-href="{{ path('api_event_draft', {id: event.id}) }}" data-duplicates-href="{{ path('app_event_edit_duplicates', {id: event.id}) }}">
                            <twig:Icon name="lucide:rocket" />
                            Publier l'événement
                        </button>
                    </div>
                </div>
            {% endif %}
            {% if hasEnded %}
                <div class="alert alert-secondary" id="event-ended">
                    <twig:Icon name="lucide:calendar-clock" />
                    <span>Cet événement est terminé. Retrouvez les prochaines sorties {{ place.location.atName }} dans <a href="{{ agenda }}">l'agenda</a>.</span>
                </div>
            {% endif %}
            {% if event.status or event.statusMessage %}
                <twig:Event:StatusAlert event="{{ event }}" prefix="Informations de dernière minute : " full="{{ true }}" />
            {% endif %}

            {# On a phone: tickets, poster, practical information, then description and comments. From lg, the tickets head
               the sidebar, which spans the rows beside the poster so the description follows the poster right away #}
            <div class="event-layout{{ bestOffer ? ' event-layout-with-tickets' }}">
                {# Right under the title: on a phone the poster and the practical information would push the booking, and
                   the other ticketing sites of the family, a screen and a half down #}
                {% if bestOffer %}
                    <div class="event-layout-tickets">
                        <div class="card card-layout mb-0" id="event-tickets">
                            <div class="card-body d-grid gap-2">
                                {% if bestOffer.affiliate %}
                                    <a href="{{ bestOffer.url }}" class="btn btn-primary btn-lg" rel="sponsored">
                                        <twig:Icon name="lucide:ticket" />
                                        Réserver mes billets
                                    </a>
                                {% else %}
                                    <a href="{{ bestOffer.url }}" class="btn btn-primary btn-lg" target="_blank" rel="noopener nofollow">
                                        <twig:Icon name="lucide:ticket" />
                                        Réserver
                                    </a>
                                {% endif %}
                                {% if offers|length > 1 %}
                                    <div class="list-group list-group-flush" id="event-ticket-offers">
                                        {% for offer in offers %}
                                            <a href="{{ offer.url }}" class="list-group-item list-group-item-action d-flex align-items-center gap-2 px-0"{% if offer.affiliate %} rel="sponsored"{% else %} target="_blank" rel="noopener nofollow"{% endif %}>
                                                <span class="fw-medium">{{ offer.seller }}</span>
                                                {% if offer.soldOut %}
                                                    <span class="ms-auto text-secondary">Complet</span>
                                                {% elseif offer.priceLabel %}
                                                    <span class="ms-auto">{{ offer.priceLabel.label }}</span>
                                                {% endif %}
                                            </a>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endif %}

                <div class="event-layout-media">
                    <div class="card card-layout overflow-visible mb-0">
                        <a class="image-gallery card-img-top d-block overflow-hidden" href="{{ original }}" title="{{ eventShortName }}">
                            <twig:Event:Poster event="{{ event }}" width="{{ 800 }}" priority="{{ true }}" id="event-poster" />
                        </a>
                        <div class="card-footer d-flex flex-wrap align-items-center gap-2">
                            {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                                <button type="button" class="btn participate btn-like-event {{ trendsData.participate ? 'btn-primary' }}"
                                        data-href="{{ path('api_event_participer', {id: event.id}) }}" data-intent="participer">
                                    <twig:Icon name="lucide:heart" />
                                    J'y vais&nbsp;!
                                </button>
                            {% else %}
                                {# Going needs an account: the button opens the login dialog (modals block), the login page without
                                   the script #}
                                <a class="btn participate" rel="nofollow" href="{{ path('app_login', {_target_path: goingAfterLogin}) }}" data-bs-toggle="modal" data-bs-target="#login-dialog" title="Connectez-vous pour indiquer que vous y allez">
                                    <twig:Icon name="lucide:heart" />
                                    J'y vais&nbsp;!
                                </a>
                            {% endif %}
                            <div class="dropdown">
                                <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <twig:Icon name="lucide:share-2" />
                                    Partager
                                </button>
                                <div class="dropdown-menu">
                                    {% for name, social in trendsData.shares %}
                                        <a href="{{ social }}" class="dropdown-item popup {{ name }}">
                                            <twig:Icon name="{{ name|social_icon }}" />
                                            {{ name|social_label }}
                                        </a>
                                    {% endfor %}
                                    <a class="dropdown-item" href="mailto:?subject={{ eventShortName|url_encode }}&amp;body={{ eventUrl|url_encode }}">
                                        <twig:Icon name="lucide:mail" />
                                        Par e-mail
                                    </a>
                                </div>
                                <button type="button" class="btn" data-copy-url="{{ eventUrl }}">
                                    <twig:Icon name="lucide:link" />
                                    Copier le lien
                                </button>
                            </div>
                            {% if going or interested %}
                                <div class="d-flex align-items-center gap-2 ms-auto small text-secondary">
                                    {% if participants %}
                                        <div class="avatar-list avatar-list-stacked">
                                            {% for participant in participants %}
                                                <span class="avatar avatar-xs rounded-circle">
                                                    <twig:User:Thumb user="{{ participant }}" width="{{ 24 }}" height="{{ 24 }}" />
                                                </span>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                    <span>
                                        {%- if going %}<strong class="text-body">{{ '{count, plural, one {# participant} other {# participants}}'|trans({count: going}, 'messages+intl-icu') }}</strong>{% endif -%}
                                        {%- if going and interested %} · {% endif -%}
                                        {%- if interested %}{{ '{count, plural, one {# intéressé} other {# intéressés}}'|trans({count: interested}, 'messages+intl-icu') }}{% endif -%}
                                    </span>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <aside class="event-layout-aside">
                    <div class="card card-layout mb-0">
                        <div class="card-header">
                            <h2 class="subheader mb-0">Informations pratiques</h2>
                        </div>
                        <div class="card-body event-facts">
                            <div class="detail-item">
                                <twig:Icon name="lucide:calendar-days" class="text-primary" />
                                <div>
                                    <div class="subheader">Date</div>
                                    <div class="fw-semibold">
                                        {% if event.endDate == null or event.startDate == event.endDate %}
                                            Le
                                            <time datetime="{{ event.startDate|date('Y-m-d\\TH:i:sO') }}">{{ event.startDate|format_date('full') }}</time>
                                        {% else %}
                                            Du
                                            <time datetime="{{ event.startDate|date('Y-m-d\\TH:i:sO') }}">{{ event.startDate|format_date('full') }}</time>
                                            au
                                            <time datetime="{{ event.endDate|date('Y-m-d\\TH:i:sO') }}">{{ event.endDate|format_date('full') }}</time>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            {% set hours = event_hours(event) %}
                            {% if hours %}
                                <div class="detail-item">
                                    <twig:Icon name="lucide:clock" class="text-primary" />
                                    <div>
                                        <div class="subheader">Horaires</div>
                                        <div class="fw-semibold">{{ hours }}</div>
                                    </div>
                                </div>
                            {% endif %}

                            {% if event.timesheets|length > 1 %}
                                <div class="detail-item">
                                    <twig:Icon name="lucide:calendar-range" class="text-primary" />
                                    <div class="min-w-0">
                                        <div class="subheader mb-1">Détail des dates</div>
                                        <twig:Event:Timesheets event="{{ event }}" />
                                    </div>
                                </div>
                            {% endif %}

                            {% if event.placeName or event.placeCity %}
                                <div class="detail-item">
                                    <twig:Icon name="lucide:map-pin" class="text-primary" />
                                    <div>
                                        <div class="subheader">Lieu</div>
                                        {% if event.placeName %}
                                            <a class="fw-semibold" href="{{ placeAgenda }}" title="Sortir {{ event.placeName|at_place }}">{{ event.placeName }}</a>
                                        {% endif %}
                                        {% if event.placeStreet %}
                                            <div class="text-secondary">{{ event.placeStreet }}</div>
                                        {% endif %}
                                        {% if event.placePostalCode or event.placeCity %}
                                            <div class="text-secondary">{{ event.placePostalCode }} {{ event.placeCity }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endif %}

                            {% if event.performers %}
                                <div class="detail-item">
                                    <twig:Icon name="lucide:music" class="text-primary" />
                                    <div>
                                        <div class="subheader">{{ '{count, plural, one {Artiste} other {Artistes}}'|trans({count: event.performers|length}, 'messages+intl-icu') }}</div>
                                        <div class="fw-semibold">{{ event.performers|join(', ') }}</div>
                                    </div>
                                </div>
                            {% endif %}

                            {# A ticketing site's prices are the ones of its offer, listed with the others under the booking button #}
                            {% if event.prices and not (event.affiliate and offers|length > 1) %}
                                <div class="detail-item">
                                    <twig:Icon name="lucide:ticket" class="text-primary" />
                                    <div>
                                        <div class="subheader">Tarifs</div>
                                        <div>{{ event.prices }}</div>
                                    </div>
                                </div>
                            {% endif %}

                            {% if event.phoneContacts or event.websiteContacts or event.mailContacts or event.facebookEventId %}
                                <div class="detail-item">
                                    <twig:Icon name="lucide:contact" class="text-primary" />
                                    <div class="min-w-0">
                                        <div class="subheader">Contact</div>
                                        {% for phoneContact in event.phoneContacts %}
                                            <div class="text-truncate"><a href="tel:{{ phoneContact }}">{{ phoneContact }}</a></div>
                                        {% endfor %}
                                        {% for websiteContact in event.websiteContacts %}
                                            {% set websiteUrl = websiteContact|ensure_protocol %}
                                            <div class="text-truncate">
                                                {% if websiteUrl %}
                                                    <a rel="nofollow" href="{{ websiteUrl }}">{{ websiteContact }}</a>
                                                {% else %}
                                                    {{ websiteContact }}
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                        {% for mailContact in event.mailContacts %}
                                            <div class="text-truncate"><a href="mailto:{{ mailContact }}">{{ mailContact }}</a></div>
                                        {% endfor %}
                                        {% if event.facebookEventId %}
                                            <div class="text-truncate"><a href="https://www.facebook.com/events/{{ event.facebookEventId }}" rel="nofollow">L'événement sur Facebook</a></div>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endif %}

                            {% set maPatisserieDisplayed = false %}
                            {% for word in ['patisserie', 'pâtisserie', 'chocolat', 'gateau', 'gâteau', 'atelier culinaire'] %}
                                {% if not maPatisserieDisplayed and (word in event.description|lower or word in event.name|lower) %}
                                    {% set maPatisserieDisplayed = true %}
                                    <div class="detail-item">
                                        <twig:Icon name="lucide:cake" class="text-primary" />
                                        <div>
                                            <div class="subheader">Notre partenaire gourmand</div>
                                            <a href="https://mapatisserie.fr">Blog de pâtisserie</a>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                        {# The directions go under the map, or here when there is none #}
                        {% set directions %}
                            {% if directionsTo %}
                                <a class="btn" href="https://www.google.com/maps/dir/?api=1&amp;destination={{ directionsTo|url_encode }}" target="_blank" rel="noopener nofollow">
                                    <twig:Icon name="lucide:navigation" />
                                    Itinéraire
                                </a>
                            {% endif %}
                        {% endset %}
                        {% set directionsHere = directionsTo and not mapValue %}
                        {% if directionsHere or calendarUrl %}
                            <div class="card-body d-grid gap-2">
                                {% if directionsHere %}
                                    {{ directions }}
                                {% endif %}
                                {% if calendarUrl %}
                                    <a class="btn" href="{{ calendarUrl }}" target="_blank" rel="noopener nofollow" title="Ajouter à Google Agenda">
                                        <twig:Icon name="lucide:calendar-plus" />
                                        Ajouter à l'agenda
                                    </a>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>

                    {% if mapValue %}
                        <div class="card card-layout mb-0">
                            <div class="card-header">
                                <h2 class="subheader mb-0">Plan</h2>
                                {% if event.placeCity %}
                                    <span class="small text-secondary ms-auto">{{ event.placeCity }}</span>
                                {% endif %}
                            </div>
                            {# Google Maps loads on demand only: no third-party request until the visitor asks for the map #}
                            <div class="ratio ratio-4x3 bg-light{{ directionsTo ? '' : ' rounded-bottom' }}" id="googleMap">
                                <div class="d-flex flex-column align-items-center justify-content-center gap-2 text-secondary">
                                    <twig:Icon name="lucide:map" class="icon-lg" />
                                    <button type="button" class="btn" id="loadMap"
                                            data-map="https://www.google.com/maps/embed/v1/place?q={{ mapValue|url_encode }}&key={{ googleMapKey }}&zoom=16">
                                        Afficher la carte
                                    </button>
                                </div>
                            </div>
                            {% if directionsTo %}
                                <div class="card-body border-top d-grid">{{ directions }}</div>
                            {% endif %}
                        </div>
                    {% endif %}
                </aside>

                <div class="event-layout-main">
                    <div class="card card-layout mb-0">
                        {% if event.description %}
                            <div class="card-body">
                                <h2 class="d-flex align-items-center gap-2 mb-3">
                                    <span class="avatar avatar-sm bg-primary-lt"><twig:Icon name="lucide:file-text" /></span>
                                    Description
                                </h2>
                                <div class="event-description">
                                    {{ eventDescription|raw }}
                                </div>
                            </div>
                        {% endif %}
                        <div class="card-body">
                            <div class="subheader mb-2">Mots-clés</div>
                            <div class="event-tags d-flex flex-wrap gap-2">
                                {% if place.country %}
                                    <a class="badge bg-secondary-lt" title="Sortir {{ place.country.atDisplayName }}" href="{{ path('app_location_index', {location: place.country.slug}) }}">
                                        Événements {{ place.country.atDisplayName }}
                                    </a>
                                {% endif %}
                                {% if place.location.isCity and event.placeName != place.location.name %}
                                    <a class="badge bg-secondary-lt" title="Sortir {{ place.location.atName }}" href="{{ agenda }}">
                                        Événements {{ place.location.atName }}
                                    </a>
                                {% endif %}
                                {% if event.placeName %}
                                    <a class="badge bg-secondary-lt" title="Sortir {{ event.placeName|at_place }}" href="{{ placeAgenda }}">
                                        Événements {{ event.placeName|at_place }}
                                    </a>
                                {% endif %}
                                {% for tag in allTags %}
                                    <a class="badge bg-primary-lt"
                                       title="{{ tag.name }} {{ place.location.atName }}"
                                       href="{{ path('app_agenda_by_tag', {tagSlug: tag.slug, tagId: tag.id, location: place.locationSlug}) }}">
                                        {{ tag.name }} {{ place.location.atName }}
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                        <div class="card-footer d-flex flex-wrap align-items-center gap-3">
                            {% if event.user %}
                                <a class="d-flex align-items-center gap-2 text-reset" href="{{ path('app_user_index', {id: event.user.id, slug: event.user.slug}) }}" title="Les événements de {{ event.user.username }}">
                                    <span class="avatar">
                                        <twig:User:Thumb user="{{ event.user }}" width="{{ 40 }}" height="{{ 40 }}" />
                                    </span>
                                    <span>
                                        <span class="subheader d-block">Publié par</span>
                                        <strong>{{ event.user.username }}</strong>
                                    </span>
                                </a>
                            {% endif %}
                            {% if event.source %}
                                <div class="small text-secondary">
                                    Source&nbsp;: <a href="{{ event.source }}" target="_blank" rel="nofollow">{{ event.fromData }}</a>
                                </div>
                            {% endif %}
                            <button type="button"
                                    class="btn btn-sm ms-auto"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalContentRemovalRequest"
                                    data-event-id="{{ event.id }}"
                                    data-event-url="{{ eventUrl }}">
                                <twig:Icon name="lucide:flag" />
                                Signaler ce contenu
                            </button>
                        </div>
                    </div>

                    {{ include('comment/list-and-form.html.twig', {event: event, comments: comments, form: commentForm, login: path('app_login', {_target_path: path('app_event_details', eventRoute|merge({_fragment: 'comments'}))})}) }}
                </div>
            </div>
        </div>

        {% if event.placeName and nextEventsData and nextEventsData.count > 0 %}
            {{ include('location/widget/next-events.html.twig', {nextEventsData: nextEventsData}) }}
        {% endif %}

        {% if similarEventsData.count > 0 %}
            {{ include('location/widget/similar-events.html.twig') }}
        {% endif %}
    {% endif %}
{%- endblock %}

{% block css %}
    {{ reprise_entry_link_tags('event_details') }}
{% endblock %}

{% block js %}
    {{ reprise_entry_script_tags('event_details') }}
{% endblock %}

{% block modals %}
    {{ include('location/event/_modal-content-removal-request.html.twig') }}
    {% if not isHiddenDraft and not is_granted('IS_AUTHENTICATED_REMEMBERED') %}
        {{ include('security/_login-dialog.html.twig', {
            id: 'login-dialog',
            title: 'Vous y allez ?',
            text: 'Connectez-vous : la sortie rejoint vos sorties, et vous revenez ici.',
            targetPath: goingAfterLogin,
        }) }}
    {% endif %}
{% endblock %}
