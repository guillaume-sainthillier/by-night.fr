{# The "J'y vais" button of the event page: under the poster, and in the action bar of a phone (like.js keeps both in
   step). Going needs an account: logged out, it opens the login dialog (modals block), the login page without the
   script #}
{% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
    <button type="button" class="btn participate btn-like-event {{ trendsData.participate ? 'btn-primary' }}{{ (class ?? null) ? ' ' ~ class }}"
            data-href="{{ path('api_event_participer', {id: event.id}) }}"{% if intent ?? true %} data-intent="participer"{% endif %}>
        <twig:Icon name="lucide:heart" />
        J'y vais&nbsp;!
    </button>
{% else %}
    <a class="btn participate{{ (class ?? null) ? ' ' ~ class }}" rel="nofollow" href="{{ path('app_login', {_target_path: goingAfterLogin}) }}" data-bs-toggle="modal" data-bs-target="#login-dialog" title="Connectez-vous pour indiquer que vous y allez">
        <twig:Icon name="lucide:heart" />
        J'y vais&nbsp;!
    </a>
{% endif %}
