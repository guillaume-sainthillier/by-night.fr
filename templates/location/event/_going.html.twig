{# The "J'y vais" button of the event page: under the poster, and in the action bar of a phone (like.js keeps both in
   step). Going needs an account: logged out, it opens the login dialog (modals block), the login page without the
   script #}
{% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
    <twig:Tabler:Button variant="{{ trendsData.participate ? 'primary' : 'default' }}" icon="lucide:heart" class="participate btn-like-event {{ class ?? '' }}" data-event-id="{{ event.id }}" data-intent="{{ (intent ?? true) ? 'participer' : false }}">J'y vais&nbsp;!</twig:Tabler:Button>
{% else %}
    <twig:Tabler:Button variant="default" href="{{ path('app_login', {_target_path: goingAfterLogin}) }}" modal="login-dialog" tooltip="Connectez-vous pour indiquer que vous y allez" icon="lucide:heart" class="participate {{ class ?? '' }}" rel="nofollow">J'y vais&nbsp;!</twig:Tabler:Button>
{% endif %}
