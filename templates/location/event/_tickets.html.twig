{# The booking button, then the other ticketing sites of the family, cheapest first. Rendered twice by the event page:
   under the title on a phone, in the practical information of the sidebar from lg; listId names one of them only.
   Umami counts a click on any of them as a "ticket-click" of the page (the event's author sees them, EventVisitSync) #}
{% if bestOffer.affiliate %}
    <a href="{{ bestOffer.url }}" class="btn btn-primary btn-lg" rel="sponsored" data-umami-event="ticket-click" data-umami-event-seller="{{ bestOffer.seller }}">
        <twig:Icon name="lucide:ticket" />
        Réserver mes billets
    </a>
{% else %}
    <a href="{{ bestOffer.url }}" class="btn btn-primary btn-lg" target="_blank" rel="noopener nofollow" data-umami-event="ticket-click" data-umami-event-seller="{{ bestOffer.seller }}">
        <twig:Icon name="lucide:ticket" />
        Réserver
    </a>
{% endif %}
{% if offers|length > 1 %}
    <div class="list-group list-group-flush"{% if listId ?? null %} id="{{ listId }}"{% endif %}>
        {% for offer in offers %}
            <a href="{{ offer.url }}" class="list-group-item list-group-item-action d-flex align-items-center gap-2 px-0" data-umami-event="ticket-click" data-umami-event-seller="{{ offer.seller }}"{% if offer.affiliate %} rel="sponsored"{% else %} target="_blank" rel="noopener nofollow"{% endif %}>
                <span class="fw-medium">{{ offer.seller }}</span>
                {% if offer.soldOut %}
                    <span class="ms-auto text-secondary">Complet</span>
                {% elseif offer.priceLabel %}
                    <span class="ms-auto">{{ offer.priceLabel.label }}</span>
                {% endif %}
            </a>
        {% endfor %}
    </div>
{% endif %}
{% if offers|filter(offer => offer.affiliate) is not empty %}
    {# The commission, said where the links are (loi n° 2023-451 du 9 juin 2023): content/transparency.html.twig explains it #}
    <p class="small text-secondary mb-0">
        <twig:Icon name="lucide:info" />
        Lien affilié&nbsp;: By Night perçoit une commission sur les billets achetés, sans surcoût pour vous.
        <a class="link-secondary text-decoration-underline" href="{{ path('app_transparency', {_fragment: 'billets'}) }}">En savoir plus</a>
    </p>
{% endif %}
