{# The booking button, then the other ticketing sites of the family, cheapest first. Rendered twice by the event page:
   under the title on a phone, in the practical information of the sidebar from lg; listId names one of them only.
   A click on any of them counts as a "ticket-click" of the page (assets/js/listeners/analytics.ts; the event's author
   sees them, EventVisitSync) #}
{% if bestOffer.affiliate %}
    <a href="{{ bestOffer.url }}" class="btn btn-primary btn-lg" rel="sponsored" data-analytics-event="ticket-click" data-analytics-seller="{{ bestOffer.seller }}">
        <twig:Tabler:Icon name="lucide:ticket" />
        Réserver mes billets
    </a>
{% else %}
    <a href="{{ bestOffer.url }}" class="btn btn-primary btn-lg" target="_blank" rel="noopener nofollow" data-analytics-event="ticket-click" data-analytics-seller="{{ bestOffer.seller }}">
        <twig:Tabler:Icon name="lucide:ticket" />
        Réserver
    </a>
{% endif %}
{% if offers|length > 1 %}
    <twig:Tabler:ListGroup flush id="{{ listId ?? null }}">
        {% for offer in offers %}
            <twig:Tabler:ListGroup:Item href="{{ offer.url }}" data-analytics-event="ticket-click" data-analytics-seller="{{ offer.seller }}" target="{{ offer.affiliate ? null : '_blank' }}" rel="{{ offer.affiliate ? 'sponsored' : 'noopener nofollow' }}" class="d-flex align-items-center gap-2 px-0">
                <span class="fw-medium">{{ offer.seller }}</span>
                {% if offer.soldOut %}
                    <span class="ms-auto text-secondary">Complet</span>
                {% elseif offer.priceLabel %}
                    <span class="ms-auto">{{ offer.priceLabel.label }}</span>
                {% endif %}
            </twig:Tabler:ListGroup:Item>
        {% endfor %}
    </twig:Tabler:ListGroup>
{% endif %}
{% if offers|filter(offer => offer.affiliate) is not empty %}
    {# The commission, said where the links are (loi n° 2023-451 du 9 juin 2023): content/transparency.html.twig explains it #}
    <p class="small text-secondary mb-0">
        <twig:Tabler:Icon name="lucide:info" />
        Lien affilié&nbsp;: By Night perçoit une commission sur les billets achetés, sans surcoût pour vous.
        <a class="link-secondary text-decoration-underline" href="{{ path('app_transparency', {_fragment: 'billets'}) }}">En savoir plus</a>
    </p>
{% endif %}
