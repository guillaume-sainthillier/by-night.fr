{# A page of the "Prochainement au même endroit" / "Le même jour" sections: their first page inline, the next ones as
   fragments appended by Widgets.js, which moves the .more-content block under the cards #}
{% for event in eventsData.events %}
    <div class="col-10 col-sm-7 col-md-6 col-lg-3 scroll-item">
        <twig:Event:Card event="{{ event }}" />
    </div>
{% endfor %}
{% if eventsData.hasNextLink %}
    {% set shown = eventsData.current %}
    {% set next = min(eventsData.paginator.maxPerPage, eventsData.count - shown) %}
    {# A button rather than a link: the fragment URL feeds the widget and must not be crawled #}
    <div class="more-content col-12 text-center mt-4" data-href="{{ eventsData.hasNextLink }}">
        <div class="small text-secondary mb-2">
            {{ shown }} sur {{ '{count, plural, one {# sortie affichée} other {# sorties affichées}}'|trans({count: eventsData.count}, 'messages+intl-icu') }}
        </div>
        <div class="progress progress-sm mx-auto mb-3 more-progress" role="progressbar" aria-label="Sorties affichées" aria-valuenow="{{ shown }}" aria-valuemin="0" aria-valuemax="{{ eventsData.count }}">
            <div class="progress-bar" style="width: {{ (shown / eventsData.count * 100)|round }}%"></div>
        </div>
        <button type="button" class="btn btn-primary btn-pill">
            <twig:Icon name="lucide:circle-plus" />
            {{ '{count, plural, one {Voir la sortie suivante} other {Voir les # sorties suivantes}}'|trans({count: next}, 'messages+intl-icu') }}
        </button>
    </div>
{% endif %}
