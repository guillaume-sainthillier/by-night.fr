<div class="btn-group">
    {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
        <button type="button" class="btn btn-icon participate btn-like-event {{ trendsData.participate ? 'btn-primary' }}"
                data-href="{{ path('api_event_participer', {id: trendsData.event.id}) }}"
                data-bs-toggle="tooltip" title="Ajouter aux favoris">
            <twig:Icon name="lucide:heart" />
        </button>
    {% else %}
        {# The like needs an account: the heart leads to the login page #}
        <a class="btn btn-icon participate" href="{{ path('app_login') }}" data-bs-toggle="tooltip" title="Connectez-vous pour ajouter cet événement à vos favoris">
            <twig:Icon name="lucide:heart" />
        </a>
    {% endif %}
    <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown" title="Partager">
        <twig:Icon name="lucide:share-2" />
    </button>
    <div class="dropdown-menu dropdown-menu-start">
        {% for name, social in trendsData.shares %}
            <a href="{{ social }}" class="dropdown-item popup {{ name }}">
                <span>
                    <twig:Icon name="{{ name|social_icon }}" />
                    Partager avec {{ name|social_label }}
                </span>
            </a>
        {% endfor %}
    </div>
</div>

<small class="ms-3 text-muted {{ trendsData.count == 0 ? 'd-none' }}">{{ '{count, plural, one {# favori} other {# favoris}}'|trans({count: trendsData.count}, 'messages+intl-icu') }}</small>
