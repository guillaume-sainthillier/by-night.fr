<twig:Event:ListWidget events="{{ topEventsData.events }}" />
{% if topEventsData.hasNextLink %}
    {# A button rather than a link: the fragment URL feeds the widget and must not be crawled #}
    <button type="button" class="more-content btn btn-outline-primary btn-block" data-href="{{ topEventsData.hasNextLink }}">Plus ({{ topEventsData.current }}
        / {{ topEventsData.count }})</button>
{% endif %}
