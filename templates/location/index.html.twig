{% extends 'layouts/full.html.twig' %}

{% block body_id 'page-location-index' %}
{% block title 'Agenda des sorties ' ~ location.atName ~ ' : concerts, spectacles, expos et soirées' %}

{% block meta_description -%}
    Que faire {{ location.atName }}&nbsp;? Retrouvez l'agenda complet des concerts, spectacles, expos, soirées et sorties en famille. Des milliers d'événements à découvrir.
{%- endblock %}

{% block breadcrumb %}
    {% if location.isCountry %}
        {% do menu.addItem(location.country.displayName, url('app_location_index', {location: location.country.slug})) %}
    {% else %}
        {% do menu.addItem(location.city.country.displayName, url('app_location_index', {location: location.city.country.slug})) %}
        {% do menu.addItem('Sortir ' ~ location.atName, url('app_location_index', {location: location.slug})) %}
    {% endif %}
{% endblock %}

{% set zone = location.isCity ? location.city : location.country %}
{% set agenda = path('app_agenda_index', {location: location.slug}) %}
{% set tones = ['primary', 'teal', 'yellow', 'blue', 'purple'] %}
{% set types = [
    {slug: 'concert', link: 'Concerts ' ~ location.atName, icon: 'lucide:music', tone: 'pink', title: 'Concerts & musique live', text: 'Scènes rock, jazz clubs, festivals, DJ sets et concerts acoustiques.'},
    {slug: 'spectacle', link: 'Spectacles ' ~ location.atName, icon: 'lucide:drama', tone: 'purple', title: 'Spectacles & théâtre', text: 'Pièces, humour, danse, cirque et one-man-shows près de chez vous.'},
    {slug: 'exposition', link: 'Les expos ' ~ location.atName, icon: 'lucide:landmark', tone: 'blue', title: 'Expositions & patrimoine', text: 'Galeries, musées, rétrospectives photo et visites guidées.'},
    {slug: 'famille', link: 'Sorties en famille ' ~ location.atName, icon: 'lucide:baby', tone: 'green', title: 'Sorties en famille', text: 'Spectacles jeune public, ateliers, parcs et balades pour tous les âges.'},
    {slug: 'etudiant', link: 'Soirées étudiantes ' ~ location.atName, icon: 'lucide:party-popper', tone: 'yellow', title: 'Soirées & vie étudiante', text: 'Afterworks, soirées étudiantes, bars et nuits en discothèque.'},
] %}

{% block body %}
    <section class="hero-location py-4 py-lg-5">
        <div class="container-lg">
            <div class="row g-4 g-lg-5 align-items-end">
                <div class="col-lg-7">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        {% if location.isCity %}
                            {% if location.city.parent %}
                                <span class="badge bg-primary-lt">
                                    <twig:Icon name="lucide:map-pin" />
                                    {{ location.city|department }}{% if location.city.parent.parent ?? null %} · {{ location.city.parent.parent.name }}{% endif %}
                                </span>
                            {% endif %}
                        {% else %}
                            <span class="badge bg-secondary-lt">
                                <twig:Flag code="{{ location.country.id }}" size="{{ 16 }}" />
                                Tout le pays
                            </span>
                        {% endif %}
                        {# The count of the nightly app:events:count-upcoming, not a COUNT of every event to come on each visit;
                           a zone whose first events came in today counts at least the ones on show #}
                        <span class="badge bg-teal-lt" id="upcoming-count">
                            {{ '{count, plural, one {# sortie à venir} other {# sorties à venir}}'|trans({count: max(zone.upcomingEvents, highlights|length)}, 'messages+intl-icu') }}
                        </span>
                    </div>
                    <h1 class="display-5 fw-bold text-start mt-3 mb-3">
                        Que faire {{ location.atName }}&nbsp;?
                        <span class="d-block text-primary text-start h1 mb-0 mt-1">{{ zone.headline ?? 'Concerts, expos & soirées' }}</span>
                    </h1>
                    <div class="lead text-secondary">
                        {% if zone.description ?? null %}
                            {{ zone.description|markdown }}
                        {% else %}
                            <p>L'agenda de toutes vos sorties {{ location.atName }}&nbsp;: concerts, spectacles, expositions, marchés, festivals, sorties en famille et soirées.</p>
                        {% endif %}
                    </div>

                    {{ form_start(search_form, {attr: {class: 'card shadow-sm mt-4 mb-0', role: 'search'}}) }}
                    <div class="card-body">
                        <div class="row g-2 align-items-end">
                            <div class="col-sm">
                                {{ form_label(search_form.term) }}
                                <div class="input-icon">
                                    <span class="input-icon-addon"><twig:Icon name="lucide:search" /></span>
                                    {{ form_widget(search_form.term) }}
                                </div>
                            </div>
                            <div class="col-sm-auto d-grid">
                                <button type="submit" class="btn btn-primary">
                                    Explorer
                                    <twig:Icon name="lucide:arrow-right" class="icon-end" />
                                </button>
                            </div>
                        </div>
                        <div class="mt-3 pt-3 border-top" role="radiogroup" aria-labelledby="location-when">
                            <div class="form-label" id="location-when">{{ search_form.when.vars.label }}</div>
                            <div class="d-flex flex-wrap gap-2">
                                {% for choice in search_form.when %}
                                    {{ form_widget(choice, {attr: {class: 'btn-check'}, label_attr: {class: 'btn btn-pill btn-chip text-nowrap'}}) }}
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                    {{ form_end(search_form) }}
                </div>
                <div class="col-lg-5">
                    <figure class="card shadow overflow-hidden border-0 m-0">
                        <div class="img-cover ratio ratio-4x3">
                            <twig:Location:Picture location="{{ zone }}" width="{{ 720 }}" height="{{ 540 }}" sizes="(min-width: 992px) 40vw, 100vw" priority="{{ true }}" />
                        </div>
                        {% if zone.heroCaption ?? null %}
                            <figcaption class="card-img-overlay card-img-overlay-dark d-flex align-items-end text-white fw-bold">{{ zone.heroCaption }}</figcaption>
                        {% endif %}
                    </figure>
                </div>
            </div>
        </div>
    </section>

    <twig:Section id="univers" eyebrow="Inspirez vos envies" icon="lucide:compass" title="Explorez par univers" description="Des spectacles jeune public du dimanche aux concerts du samedi soir, trouvez la sortie qui vous ressemble {{ location.atName }}.">
        <div class="row row-cards row-cols-2 row-cols-md-3 row-cols-lg-5">
            {% for type in types %}
                <div class="col">
                    <twig:Tile
                        href="{{ path('app_agenda_by_type', {typeSlug: type.slug, location: location.slug}) }}"
                        title="{{ type.title }}"
                        description="{{ type.text }}"
                        icon="{{ type.icon }}"
                        tone="{{ type.tone }}"
                        meta="{{ type.link }}"
                    />
                </div>
            {% endfor %}
        </div>
    </twig:Section>

    {% if cities %}
        <twig:Section id="venues" eyebrow="Où sortir" icon="lucide:building-2" title="Les villes les plus animées" description="Les villes {{ location.name|of_place }} qui comptent le plus de sorties à venir.">
            <div class="row row-cards row-cols-2 row-cols-md-3 row-cols-lg-5">
                {% for row in cities %}
                    {% set city = row[0] %}
                    {# ICU messages stay in {{ }}: in a {% %} tag, the <twig:…> pre-lexer would read their "{#" as a comment #}
                    {% set meta %}{{ '{count, plural, one {# sortie} other {# sorties}}'|trans({count: row.events}, 'messages+intl-icu') }}{% endset %}
                    <div class="col">
                        <twig:Tile
                            href="{{ path('app_location_index', {location: city.slug}) }}"
                            title="{{ city.name }}"
                            description="{{ (city|department) ?: (city.headline ?? null) }}"
                            tone="{{ tones[loop.index0 % tones|length] }}"
                            meta="{{ meta }}"
                        />
                    </div>
                {% endfor %}
            </div>
        </twig:Section>
    {% elseif venues %}
        <twig:Section id="venues" eyebrow="Où sortir" icon="lucide:map-pinned" title="Les lieux incontournables" description="Les salles, scènes et lieux {{ location.isCity ? location.name|of_place : location.atName }} qui programment le plus de sorties en ce moment.">
            <div class="row row-cards row-cols-2 row-cols-md-3 row-cols-lg-5">
                {% for venue in venues %}
                    {% set place = venue[0] %}
                    {% set meta %}{{ '{count, plural, one {# sortie} other {# sorties}}'|trans({count: venue.events}, 'messages+intl-icu') }}{% endset %}
                    <div class="col">
                        <twig:Tile
                            href="{{ path('app_agenda_by_place', {location: location.slug, placeSlug: place.slug}) }}"
                            title="{{ place.name }}"
                            description="{{ place.street ?? place.cityName }}"
                            icon="{{ ['lucide:landmark', 'lucide:music', 'lucide:drama', 'lucide:ticket', 'lucide:star'][loop.index0 % 5] }}"
                            tone="{{ tones[loop.index0 % tones|length] }}"
                            meta="{{ meta }}"
                        />
                    </div>
                {% endfor %}
            </div>
        </twig:Section>
    {% endif %}

    {% if highlights %}
        <twig:Section muted="{{ true }}">
            <twig:block name="header">
                <twig:Section:Header eyebrow="La sélection de la semaine" icon="lucide:star" title="À l'affiche {{ location.atName }} cette semaine" />
            </twig:block>
            <div class="row row-cards row-scroll-mobile">
                {% for event in highlights %}
                    <div class="col-10 col-sm-7 col-md-6 col-lg-3">
                        <twig:Event:Card event="{{ event }}" tone="{{ ['primary', 'teal', 'pink', 'blue'][loop.index0 % 4] }}" />
                    </div>
                {% endfor %}
            </div>
            <div class="text-center mt-4">
                <a href="{{ agenda }}" class="btn btn-primary btn-pill">
                    Voir l'agenda<span class="d-none d-md-inline">&nbsp;{{ location.atName }}</span>
                    <twig:Icon name="lucide:arrow-right" class="icon-end" />
                </a>
            </div>
        </twig:Section>
    {% endif %}

    {% if neighbours %}
        {% if location.isCity %}
            <twig:Section id="neighbours" eyebrow="Aux alentours" icon="lucide:compass" title="Sortir autour {{ location.name|of_place }}">
                <div class="row row-cards row-cols-2 row-cols-md-3 row-cols-xl-6">
                    {% for row in neighbours %}
                        {% set city = row[0] %}
                        <div class="col">
                            <twig:Location:PlaceCard
                                href="{{ path('app_agenda_index', {location: city.slug}) }}"
                                name="{{ city.name }}"
                                eyebrow="{{ city|department }}"
                                events="{{ row.events }}"
                                title="Que faire {{ city.name|at_place }} ?"
                            />
                        </div>
                    {% endfor %}
                    <div class="col">
                        <a class="card card-layout card-link-pop bg-primary text-white h-100 mb-0" href="{{ path('app_location_index', {location: location.city.country.slug}) }}" title="Que faire {{ location.city.country.atDisplayName }}&nbsp;?">
                            <div class="card-body">
                                <twig:Flag code="{{ location.city.country.id }}" size="{{ 28 }}" class="mb-2" />
                                <h3 class="card-title mb-0">{{ location.city.country.displayName }}</h3>
                            </div>
                            <div class="card-footer card-footer-transparent text-white d-flex align-items-center justify-content-between small fw-bold">
                                <span>Tout le pays</span>
                                <twig:Icon name="lucide:arrow-right" />
                            </div>
                        </a>
                    </div>
                </div>
            </twig:Section>
        {% else %}
            <twig:Section id="neighbours" eyebrow="Pays & territoires" icon="lucide:globe" title="Explorer les autres pays">
                <twig:Location:CountryGrid countries="{{ neighbours }}" />
            </twig:Section>
        {% endif %}
    {% endif %}

    {# Right under the white section of the neighbours, which already spaces it #}
    <section class="{{ neighbours ? 'pb-5' : 'py-5' }}">
        <div class="container-lg">
            <twig:OrganizerCta atName="{{ location.atName }}" />
        </div>
    </section>

    <section class="py-5">
        <div class="container-lg">
            <div class="row">
                <div class="col-lg-9 text-secondary">
                    <h2 class="h2 text-body">Que faire {{ location.atName }} aujourd'hui ou ce soir&nbsp;?</h2>
                    <p>Vous vous demandez <strong>que faire {{ location.atName }}</strong>&nbsp;? Parcourez notre agenda pour trouver un
                        <strong>concert</strong>, une <strong>expo</strong>, un <strong>spectacle</strong>, un <strong>marché</strong> ou une
                        <strong>sortie</strong> près de chez vous. Il y en a pour tous les goûts et pour tous les âges&nbsp;: des
                        <strong>sorties en famille</strong> et <strong>spectacles jeune public</strong> aux <strong>soirées étudiantes</strong>
                        les plus branchées dans les <strong>bars</strong> et <strong>discothèques</strong> {{ location.name|of_place }}.
                    </p>
                    {% if location.isCity %}
                        <p>{{ location.appName }} centralise pour vous les <strong>événements et bons plans culturels</strong> de la ville {{ location.name|of_place }} et de ses environs.
                            Notre objectif&nbsp;: rassembler toutes les <strong>choses à faire {{ location.atName }}</strong> sur une seule plateforme pour trouver les meilleures <strong>idées de sorties</strong>.
                        </p>
                    {% else %}
                        <p>{{ location.appName }} centralise pour vous les <strong>événements et bons plans culturels</strong> dans toutes les villes {{ location.name|of_place }}.
                            Notre objectif&nbsp;: rassembler toutes les <strong>choses à faire {{ location.atName }}</strong> sur une seule plateforme pour trouver les meilleures <strong>idées de sorties</strong>.
                        </p>
                    {% endif %}
                    <p class="mb-0">Vous êtes <strong>organisateur d'événements</strong>, artiste ou <strong>agence de communication</strong> {{ location.atName }}&nbsp;?
                        <a href="{{ path('app_event_new') }}">Publiez gratuitement votre événement</a> et donnez-lui un maximum de <strong>visibilité</strong>.
                    </p>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
