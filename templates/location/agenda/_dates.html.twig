{# The date shortcuts of the agenda, the first way through it ("what's on tonight?"), each with its count of the page's
   other filters (EventElasticaRepository::getFacets()). "Tous les jours" leaves the period out of the URL. Not followed:
   their dates change every day. One line that scrolls sideways on a phone, wrapped where a mouse cannot swipe it. #}
<div class="agenda-dates" id="agenda-dates" role="group" aria-label="Dates">
    {% for preset in enum_cases('App\\Enum\\DateRangePreset') %}
        {% set count = facets.dates[preset.value] ?? null %}
        {% set when = preset.value == 'anytime' ? {} : {when: preset.value} %}
        <twig:Chip href="{{ path(app.current_route, routeParams|merge(undatedFilters)|merge(when)) }}" active="{{ search.preset is same as(preset) }}" class="btn-sm text-nowrap flex-shrink-0" rel="nofollow">
            {{ preset.label }}
            {% if count is not null %}<span class="ms-1 opacity-75 fw-normal">{{ count }}</span>{% endif %}
        </twig:Chip>
    {% endfor %}
</div>
