{% if events.nbResults > 0 %}
    <twig:Event:ListGridVertical events="{{ events }}" stretched="{{ true }}" />

    {% if events.hasNextPage() %}
        <div class="text-center my-4">
            <a id="paginate"
               class="btn btn-outline-primary"
               href="{{ path(app.request.get('_route'), routeParams) }}">
                Plus d'événements
            </a>
        </div>
    {% endif %}
{% endif %}
