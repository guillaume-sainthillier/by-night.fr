<header class="navbar navbar-expand-lg sticky-top" data-bs-theme="light">
    <div class="{{ container_class }}">
        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbar-main" aria-label="Ouvrir le menu">
            <twig:Icon name="lucide:menu" />
        </button>
        <a href="{{ path('app_index') }}" title="By Night&nbsp;: agenda des sorties, concerts et spectacles en France" class="navbar-brand site-brand flex-shrink-0">
            <twig:Picasso:Image src="{{ asset('build/images/by-night.png', 'local') }}" width="{{ 40 }}" height="{{ 40 }}" alt="" priority="{{ true }}" />
            <span class="site-brand-text">
                <span class="site-brand-name">By Night</span>
                <span class="site-brand-tagline d-none d-sm-block">L'agenda de vos sorties</span>
            </span>
        </a>
        <div class="d-flex d-lg-none">
            <ul class="navbar-nav flex-row gap-3 align-items-center">
                <li class="nav-item">
                    <a class="nav-link" href="#" id="autocomplete-mobile-toggler" aria-label="Rechercher">
                        <twig:Icon name="lucide:search" />
                    </a>
                </li>
                {{ include('fragments/_header-user-dropdown.html.twig', {show_username: false}) }}
            </ul>
        </div>
        <div class="offcanvas-lg offcanvas-end flex-grow-1" id="navbar-main">
            <div class="offcanvas-header">
                <div class="site-brand">
                    <twig:Picasso:Image src="{{ asset('build/images/by-night.png', 'local') }}" width="{{ 36 }}" height="{{ 36 }}" alt="" priority="{{ true }}" />
                    <span class="site-brand-name">By Night</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#navbar-main" aria-label="Fermer"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column flex-lg-row align-items-lg-center gap-2 gap-lg-3">
                <ul class="navbar-nav align-items-start align-items-lg-center">
                    {% set city = app_context.city %}
                    {% if city %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_location_index', {location: city.slug}) }}" title="Que faire {{ city.name|at_place }}&nbsp;?">
                                <span class="nav-link-icon"><twig:Icon name="lucide:map-pin" /></span>
                                <span class="nav-link-title">{{ city.name }}</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_agenda_index', {location: city.slug}) }}" title="Agenda des sorties {{ city.name|at_place }}">
                                <span class="nav-link-icon"><twig:Icon name="lucide:calendar-days" /></span>
                                <span class="nav-link-title">Agenda</span>
                            </a>
                        </li>
                    {% endif %}
                </ul>

                <div id="autocomplete" class="mx-lg-auto d-flex flex-lg-grow-1 min-w-0 order-first order-lg-0 mb-2 mb-lg-0" data-search-url="{{ path('api_search') }}" data-suggestions-url="{{ path('api_search_suggestions', city ? {city: city.slug} : {}) }}" data-search-page-url="{{ path('app_search_index') }}"></div>

                {% if is_granted('ROLE_ADMIN') %}
                    <ul class="navbar-nav align-items-start align-items-lg-center">
                        <li class="nav-item dropdown">
                            <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Admin</a>
                            <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                                <a class="dropdown-item" href="{{ path('admin') }}">Administration</a>
                                <a class="dropdown-item" href="{{ path('app_administration_info_index') }}">Réseaux sociaux</a>
                                <a class="dropdown-item js-impersonate" href="#" data-url="{{ url('api_users_autocomplete', {q: '__QUERY__'}) }}">Impersonation</a>
                            </div>
                        </li>
                    </ul>
                {% endif %}
                <ul class="d-none d-lg-flex navbar-nav align-items-center">
                    {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                        {{ include('fragments/_header-user-dropdown.html.twig', {show_username: true}) }}
                    {% else %}
                        <li class="nav-item">
                            <a class="nav-link" title="Connectez-vous sur By Night" href="{{ path('app_login') }}">
                                Connexion
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" title="Créez votre compte gratuitement" href="{{ path('app_register') }}">
                                Inscription
                            </a>
                        </li>
                    {% endif %}
                </ul>
                <div class="vr d-none d-lg-block"></div>
                <a class="btn btn-primary btn-pill site-header-cta" title="Publiez votre événement gratuitement" aria-label="Publier un événement" href="{{ path('app_event_new') }}">
                    <twig:Icon name="lucide:circle-plus" />
                    {# Icon only on large screens, where the header is tightest #}
                    <span class="d-lg-none d-xl-inline">Publier un événement</span>
                </a>
                {% if not is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                    <div class="d-flex d-lg-none gap-2 w-100">
                        <a class="btn btn-outline-secondary flex-fill" href="{{ path('app_login') }}">Connexion</a>
                        <a class="btn btn-outline-secondary flex-fill" href="{{ path('app_register') }}">Inscription</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</header>
