{% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
    <li class="nav-item dropdown nav-avatar">
        <a href="#" class="nav-link d-flex align-items-center dropdown-toggle" data-bs-toggle="dropdown">
            <twig:Tabler:Avatar size="sm">
                <twig:User:Thumb user="{{ app.user }}" width="{{ 32 }}" height="{{ 32 }}" placeholder="{{ false }}" />
            </twig:Tabler:Avatar>
            {% if show_username %}
                <span class="d-lg-none ms-2">{{ app.user.username }}</span>
            {% endif %}
        </a>
        <twig:Tabler:Dropdown:Menu end arrow data-bs-theme="light">
            {% if is_granted('IS_IMPERSONATOR') %}
                <twig:Tabler:Dropdown:Item icon="lucide:power" href="{{ impersonation_exit_path(path('app_index')) }}">
                    Quitter l'impersonation
                </twig:Tabler:Dropdown:Item>
                <twig:Tabler:Dropdown:Divider />
            {% endif %}
            {# The member who goes out, then the organizer #}
            <twig:Tabler:Dropdown:Item icon="lucide:heart" title="Les événements où je vais" href="{{ path('app_outing_list') }}">
                Mes sorties
            </twig:Tabler:Dropdown:Item>
            <twig:Tabler:Dropdown:Item icon="lucide:bell" title="Les organisateurs et les lieux que je suis" href="{{ path('app_follow_list') }}">
                Mes abonnements
            </twig:Tabler:Dropdown:Item>
            <twig:Tabler:Dropdown:Item icon="lucide:list-checks" title="Gérer les événements que j'ai publiés" href="{{ path('app_personal_space_events') }}">
                Mes événements publiés
            </twig:Tabler:Dropdown:Item>
            <twig:Tabler:Dropdown:Item icon="lucide:megaphone" title="Présenter mon lieu, mon collectif ou moi-même aux visiteurs" href="{{ path('app_personal_space_publisher') }}">
                Ma page organisateur
            </twig:Tabler:Dropdown:Item>
            <twig:Tabler:Dropdown:Item icon="lucide:settings" title="Accéder à mon compte" href="{{ path('app_user_edit') }}">
                Mon compte
            </twig:Tabler:Dropdown:Item>
            <twig:Tabler:Dropdown:Item icon="lucide:user" title="Accéder à mon profil public" href="{{ path('app_user_index', {id: app.user.id, slug: app.user.slug}) }}">
                Profil public
            </twig:Tabler:Dropdown:Item>
            <twig:Tabler:Dropdown:Divider />
            <twig:Tabler:Dropdown:Item icon="lucide:power" href="{{ path('_logout_main') }}">
                Déconnexion
            </twig:Tabler:Dropdown:Item>
        </twig:Tabler:Dropdown:Menu>
    </li>
{% endif %}
