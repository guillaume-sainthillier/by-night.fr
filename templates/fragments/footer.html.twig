{% set countries = footer_countries() %}
{% set footer_location = app_context.slug ?? (countries|first).slug ?? null %}
<footer id="footer" class="footer">
    <div class="{{ container_class }}">
        <div class="row g-4 g-lg-5">
            <div class="col-lg-4">
                <a href="{{ path('app_index') }}" class="site-brand mb-3" title="By Night&nbsp;: agenda des sorties, concerts et spectacles en France">
                    <twig:Picasso:Image src="{{ asset('build/images/logo-icon.svg') }}" width="{{ 36 }}" height="{{ 36 }}" alt="" unoptimized="{{ true }}" />
                    <span class="site-brand-name">By Night</span>
                </a>
                <p class="text-secondary">
                    L'agenda indépendant de vos concerts, spectacles, expos, marchés et soirées.
                    Plus de {{ events_count_label() }} référencés depuis 2013.
                </p>
            </div>
            {% if footer_location %}
                <nav class="col-6 col-md-3 col-lg-2" aria-labelledby="footer-types">
                    <div id="footer-types" class="subheader mb-3">Par univers</div>
                    <ul class="list-unstyled">
                        {% for type in enum_cases('App\\Enum\\AgendaType') %}
                            <li class="mb-2"><a class="link-secondary" href="{{ path('app_agenda_by_type', {typeSlug: type.slug, location: footer_location}) }}">{{ type.label }}</a></li>
                        {% endfor %}
                    </ul>
                </nav>
            {% endif %}
            <nav class="col-6 col-md-3 col-lg-2 sites" aria-labelledby="footer-cities">
                <div id="footer-cities" class="subheader mb-3">Sortir par ville</div>
                <ul class="list-unstyled">
                    {% for city in random_cities(app_context.country) %}
                        <li class="mb-2">
                            <a class="link-secondary" title="Sortir {{ city.name|at_place }}, {{ city.country }}" href="{{ path('app_location_index', {location: city.slug}) }}">
                                {{ city.name }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>
            <nav class="col-6 col-md-3 col-lg-2" aria-labelledby="footer-countries">
                <div id="footer-countries" class="subheader mb-3">Pays & territoires</div>
                <ul class="list-unstyled">
                    {% for country in countries %}
                        <li class="mb-2">
                            <a class="link-secondary" title="Que faire {{ country.atDisplayName }}&nbsp;?" href="{{ path('app_location_index', {location: country.slug}) }}">
                                {{ country.displayName }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>
            <nav class="col-6 col-md-3 col-lg-2" aria-labelledby="footer-site">
                <div id="footer-site" class="subheader mb-3">By Night</div>
                {{ include('fragments/_footer-site-links.html.twig') }}
            </nav>
        </div>
        <div class="border-top mt-5 pt-4">
            <div class="subheader mb-2">Nos sites partenaires</div>
            <ul class="list-inline mb-0 small">
                <li class="list-inline-item"><a class="link-secondary" title="Actualités techniques autour du Web et de PHP" href="https://blog.silarhi.fr">Actualités Web & PHP</a></li>
                <li class="list-inline-item"><a class="link-secondary" title="Développement d'applications Web à Toulouse" href="https://silarhi.fr">Développement Web Toulouse</a></li>
                <li class="list-inline-item"><a class="link-secondary" title="Offre de parrainage Boursorama {{ 'now'|date('Y') }}" href="https://parrainages-boursorama.fr">Parrainage Boursorama</a></li>
                <li class="list-inline-item"><a class="link-secondary" title="Offre de parrainage Fortuneo {{ 'now'|date('Y') }}" href="https://offre-parrainages.fr/offres/offre-parrainage-fortuneo">Parrainage Fortuneo</a></li>
                <li class="list-inline-item"><a class="link-secondary" title="Offre de parrainage ING {{ 'now'|date('Y') }}" href="https://offre-parrainages.fr/offres/offre-parrainage-ing-direct">Parrainage ING</a></li>
                <li class="list-inline-item"><a class="link-secondary" title="Offre de parrainage Hello Bank {{ 'now'|date('Y') }}" href="https://offre-parrainages.fr/offres/offre-parrainage-hello-bank">Parrainage Hello Bank</a></li>
                <li class="list-inline-item"><a class="link-secondary" title="Offre de parrainage Yomoni {{ 'now'|date('Y') }}" href="https://offre-parrainages.fr/offres/offre-parrainage-yomoni">Parrainage Yomoni</a></li>
                <li class="list-inline-item"><a class="link-secondary" title="Offre de parrainage BforBank {{ 'now'|date('Y') }}" href="https://offre-parrainages.fr/offres/offre-parrainage-bforbank">Parrainage BforBank</a></li>
                <li class="list-inline-item"><a class="link-secondary" title="Offres de parrainage {{ 'now'|date('Y') }}" href="https://offre-parrainages.fr">Offres de parrainage</a></li>
                <li class="list-inline-item"><a class="link-secondary" title="Comparatif banque" href="https://avis-banque.fr">Comparatif banque</a></li>
            </ul>
        </div>
        {{ include('fragments/_footer-credits.html.twig') }}
    </div>
</footer>
